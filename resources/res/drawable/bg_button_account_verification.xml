<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="@dimen/common_corner_small"/>
            <solid android:color="#80124ee6"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/common_corner_small"/>
            <solid android:color="@color/main_color_common_blue_press"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/common_corner_small"/>
            <solid android:color="@color/main_color_blue_dark"/>
        </shape>
    </item>
</selector>
