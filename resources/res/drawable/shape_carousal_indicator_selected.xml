<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <size
                android:height="4dp"
                android:width="12dp"/>
            <solid android:color="@color/main_color_blue_dark"/>
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <size
                android:height="4dp"
                android:width="4dp"/>
            <solid android:color="#e6e9ee"/>
        </shape>
    </item>
</selector>
