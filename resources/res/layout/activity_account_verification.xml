<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/activity_account_verification_0"
    android:background="@color/main_color_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_basic"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/main_color_black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/sec_verify_other_btn_login"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_word_7e"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sec_verify_unregistered_tip"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/noproguard_clear_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="11dp"/>
    <com.baicizhan.client.business.widget.EmailAutoCompleteEditText
        android:textSize="17sp"
        android:textColor="@color/editable_text_view_color"
        android:textColorHint="@color/main_color_word_b8"
        android:gravity="center_vertical"
        android:id="@+id/account"
        android:background="#00000000"
        android:paddingRight="38dp"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="40dp"
        android:hint="@string/login_account_phone"
        android:maxEms="30"
        android:singleLine="true"
        android:inputType="phone"
        android:imeOptions="flagNoExtractUi"
        android:textCursorDrawable="@null"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:autoCompleteColor="#bdbdbd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc"/>
    <View
        android:id="@+id/view"
        android:background="@color/main_color_strong_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/account"/>
    <com.baicizhan.main.customview.CountDownButton
        android:enabled="false"
        android:textSize="13dp"
        android:textColor="@color/main_color_blue_light"
        android:id="@+id/noproguard_auth_code"
        android:background="#00000000"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:text="@string/send_num"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/account"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/account_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="noproguard_auth_code,noproguard_clear_guideline"/>
    <ImageView
        android:id="@+id/account_clear"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_input_clear_normal_default"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toStartOf="@+id/account_barrier"
        app:layout_constraintTop_toTopOf="@+id/account"/>
    <EditText
        android:textSize="17sp"
        android:textColor="@color/main_color_main_word"
        android:textColorHint="@color/main_color_word_b8"
        android:gravity="center_vertical"
        android:id="@+id/noproguard_verify_code"
        android:background="#00000000"
        android:paddingRight="76dp"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:hint="@string/verification_auth_code"
        android:singleLine="true"
        android:inputType="number"
        android:textCursorDrawable="@null"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view"/>
    <View
        android:background="@color/main_color_strong_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_verify_code"/>
    <ImageView
        android:id="@+id/noproguard_see"
        android:background="?attr/actionBarItemBackground"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_password_display"
        android:scaleType="centerInside"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/noproguard_verify_code"/>
    <ImageView
        android:id="@+id/verify_code_clear"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_input_clear_normal_default"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toStartOf="@+id/password_barrier"
        app:layout_constraintTop_toTopOf="@+id/noproguard_verify_code"/>
    <EditText
        android:textSize="17sp"
        android:textColor="@color/main_color_main_word"
        android:textColorHint="@color/main_color_word_b8"
        android:gravity="center_vertical"
        android:id="@+id/noproguard_new_password"
        android:background="#00000000"
        android:paddingRight="76dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:hint="新密码（6-35位）"
        android:singleLine="true"
        android:inputType="textPassword"
        android:textCursorDrawable="@null"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_verify_code"/>
    <View
        android:id="@+id/divider_new_pwd"
        android:background="@color/main_color_strong_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_new_password"/>
    <ImageView
        android:id="@+id/noproguard_pwd_see"
        android:background="?attr/actionBarItemBackground"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_password_display"
        android:scaleType="centerInside"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/noproguard_new_password"/>
    <ImageView
        android:id="@+id/noproguard_new_password_clear"
        android:visibility="gone"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_input_clear_normal_default"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toStartOf="@+id/password_new_barrier"
        app:layout_constraintTop_toTopOf="@+id/noproguard_new_password"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/password_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="noproguard_see,noproguard_clear_guideline"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/noproguard_verify_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="noproguard_verify_code,noproguard_new_password"/>
    <Button
        android:enabled="false"
        android:textSize="17dp"
        android:textColor="#ffffff"
        android:id="@+id/verify"
        android:background="@drawable/bg_button_account_verification"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="36dp"
        android:text="@string/login_login"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_verify_barrier"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_blue_dark"
        android:gravity="center"
        android:id="@+id/forget_password"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/login_forget"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/verify"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/main_color_word_b8"
        android:gravity="center"
        android:id="@+id/agreement"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/weibo_mail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"
        app:layout_constraintGuide_percent="0.5"/>
    <FrameLayout
        android:id="@+id/weibo_btn"
        android:background="@drawable/bg_weibo_or_mail_login"
        android:visibility="gone"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/agreement"
        app:layout_constraintEnd_toStartOf="@+id/weibo_mail">
        <TextView
            android:textSize="14dp"
            android:textColor="#283044"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="微博账号登录"
            android:drawableLeft="@drawable/ic_weibo"
            android:drawablePadding="8dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mail_btn"
        android:background="@drawable/bg_weibo_or_mail_login"
        android:visibility="gone"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/agreement"
        app:layout_constraintStart_toStartOf="@+id/weibo_mail">
        <TextView
            android:textSize="14dp"
            android:textColor="#283044"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_mail_title"
            android:drawableLeft="@drawable/ic_mail"
            android:drawablePadding="8dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/password_new_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="noproguard_pwd_see,noproguard_clear_guideline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
