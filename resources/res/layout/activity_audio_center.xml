<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_audio_center_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_basic"/>
    <com.google.android.material.tabs.TabLayout
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        android:id="@+id/tablayout"
        android:background="@color/main_color_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/main_color_black"
        app:tabSelectedTextColor="@color/main_color_black"
        app:tabTextAppearance="@style/TabLayoutTextAppearance"
        app:tabTextColor="@color/main_color_black"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:background="?attr/color_common_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tablayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
