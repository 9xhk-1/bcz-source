<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_color_weak_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.baicizhan.main.customview.PatternContainer
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <LinearLayout
                android:layout_width="116dp"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/home"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:src="@drawable/ic_action_bar_back_old"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/main_color_word_b8"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/remain_count"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:text="需复习"/>
            </LinearLayout>
            <View
                android:background="@color/main_color_weak_divider"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_color_word_b8"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/last_topic"
                android:paddingLeft="16dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:drawablePadding="12dp"
                android:layout_weight="2"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/topic_review_container"
            android:background="@color/study_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/learning_footer"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="85dp"
                android:layout_weight="1"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/hint"
                android:background="@drawable/button_study_bottom_bar"
                android:layout_width="85dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_study_hint"
                android:scaleType="centerInside"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/voice"
                android:background="@drawable/button_study_bottom_bar"
                android:layout_width="85dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_study_sound_3"
                android:scaleType="centerInside"/>
        </LinearLayout>
    </com.baicizhan.main.customview.PatternContainer>
    <View
        android:id="@+id/disable_click"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.baicizhan.client.business.widget.SwipeViewPager
        android:id="@+id/wiki_pager"
        android:background="@android:color/transparent"
        android:visibility="invisible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="#00000000"
        android:divider="@null"/>
</FrameLayout>
