<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_edit_schedule_0"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/action_bar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/back_img"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_action_bar_back_old"
            android:scaleType="centerInside"
            android:layout_alignParentLeft="true"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab"
            android:layout_width="192dp"
            android:layout_height="44dp"
            android:layout_centerHorizontal="true"
            app:tabBackground="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/schedule_tab_indicator"
            app:tabIndicatorAnimationDuration="300"
            app:tabIndicatorColor="@color/main_color_blue_dark"
            app:tabMaxWidth="96dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/main_color_blue_dark"
            app:tabTextAppearance="@style/BczTabLayoutTextStyle"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/main_color_word_822"
            android:id="@+id/title"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/main_color_word_822"
            android:id="@+id/badge_text"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginRight="16dp"
            android:text="徽章"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/single_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
