<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_everyday_notice_setting_0"
    android:background="@color/main_color_weak_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_basic"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/main_color_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <RelativeLayout
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/main_color_main_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_remind_system_switch"
                android:layout_centerVertical="true"/>
            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/switcher"
                android:layout_width="50dp"
                android:layout_height="25dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:offColor="@color/main_color_word_hint"
                app:onColor="@color/main_color_common_blue"
                app:thumbColor="@color/main_color_white"
                app:thumbPressedColor="@color/main_color_white"
                app:thumb_height="25dp"
                app:thumb_margin="3dp"
                app:thumb_width="25dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/pick_date_btn"
            android:background="@drawable/white_ffe6e9ee"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/main_color_main_word"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="@string/setting_remind_system_subtitle"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ff3568fa"
                android:gravity="right"
                android:id="@+id/select_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/notice_date_picker"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="256dp"
            android:layout_marginTop="16dp">
            <com.aigestudio.wheelpicker.WheelPicker
                android:id="@+id/notice_am"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:wheel_atmospheric="true"
                app:wheel_data="@array/notice_half_days"
                app:wheel_indicator="true"
                app:wheel_indicator_color="@color/main_blue"
                app:wheel_indicator_size="1dp"
                app:wheel_item_space="8dp"
                app:wheel_item_text_color="#ffbbbbbb"
                app:wheel_item_text_size="14sp"
                app:wheel_selected_item_text_color="@color/main_color_main_word"
                app:wheel_visible_item_count="5"/>
            <com.aigestudio.wheelpicker.WheelPicker
                android:id="@+id/notice_hour"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:wheel_atmospheric="true"
                app:wheel_indicator="true"
                app:wheel_indicator_color="@color/main_blue"
                app:wheel_indicator_size="1dp"
                app:wheel_item_space="8dp"
                app:wheel_item_text_color="#ffbbbbbb"
                app:wheel_item_text_size="14sp"
                app:wheel_selected_item_text_color="@color/main_color_main_word"
                app:wheel_visible_item_count="5"/>
            <com.aigestudio.wheelpicker.WheelPicker
                android:id="@+id/notice_minute"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:wheel_atmospheric="true"
                app:wheel_indicator="true"
                app:wheel_indicator_color="@color/main_blue"
                app:wheel_indicator_size="1dp"
                app:wheel_item_space="8dp"
                app:wheel_item_text_color="#ffbbbbbb"
                app:wheel_item_text_size="14sp"
                app:wheel_selected_item_text_color="@color/main_color_main_word"
                app:wheel_visible_item_count="5"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
