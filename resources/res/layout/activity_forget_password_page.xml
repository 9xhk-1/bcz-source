<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_forget_password_page_0"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_1"
        android:background="@color/main_color_white"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/action_bar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/action_bar_basic"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/main_color_black"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:text="@string/forget_pswd"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
        <RelativeLayout
            android:id="@+id/forget_password_content"
            android:background="#ffffffff"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <com.baicizhan.main.customview.CountDownButton
                android:enabled="false"
                android:textSize="13dp"
                android:textColor="@color/main_color_blue_light"
                android:id="@+id/get_auth_code"
                android:background="#00000000"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="25dp"
                android:text="@string/send_num"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/account_clear"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_input_clear_normal_default"
                android:scaleType="centerInside"
                android:layout_toLeftOf="@+id/get_auth_code"/>
            <com.baicizhan.client.business.widget.EmailAutoCompleteEditText
                android:textSize="17sp"
                android:textColor="#464646"
                android:textColorHint="#959595"
                android:gravity="center_vertical"
                android:id="@+id/account"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginLeft="24dp"
                android:hint="手机号/邮箱"
                android:maxEms="30"
                android:singleLine="true"
                android:layout_toLeftOf="@+id/account_clear"
                android:inputType="textEmailAddress"
                android:imeOptions="flagNoExtractUi"
                android:imeActionLabel="确定发送"
                android:imeActionId="@integer/send"
                android:textCursorDrawable="@null"
                app:autoCompleteColor="#bdbdbd"/>
            <View
                android:background="@color/main_color_strong_divider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_below="@+id/account"/>
            <EditText
                android:textSize="17dp"
                android:textColor="#464646"
                android:textColorHint="#959595"
                android:gravity="center_vertical"
                android:id="@+id/auth_code"
                android:background="@color/main_color_white"
                android:paddingRight="38dp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="24dp"
                android:hint="收到的验证码"
                android:singleLine="true"
                android:layout_below="@+id/account"
                android:inputType="number"/>
            <View
                android:background="@color/main_color_strong_divider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_below="@+id/auth_code"/>
            <ImageView
                android:id="@+id/auth_code_clear"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:src="@drawable/ic_input_clear_normal_default"
                android:scaleType="centerInside"
                android:layout_below="@+id/account"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/see"
                android:background="?attr/actionBarItemBackground"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:src="@drawable/password_btn_hide_normal_default"
                android:scaleType="centerInside"
                android:layout_below="@+id/auth_code"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/password_clear"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_input_clear_normal_default"
                android:scaleType="centerInside"
                android:layout_toLeftOf="@+id/see"
                android:layout_below="@+id/auth_code"/>
            <EditText
                android:textSize="17dp"
                android:textColor="#464646"
                android:textColorHint="#959595"
                android:gravity="bottom"
                android:id="@+id/new_password"
                android:background="@android:color/transparent"
                android:paddingRight="15dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="24dp"
                android:hint="新密码(6-35位)"
                android:singleLine="true"
                android:layout_toLeftOf="@+id/password_clear"
                android:layout_below="@+id/auth_code"
                android:inputType="textPassword"/>
            <View
                android:background="@color/main_color_strong_divider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="59dp"
                android:layout_marginRight="24dp"
                android:layout_below="@+id/auth_code"/>
            <Button
                android:enabled="false"
                android:textSize="17dp"
                android:textColor="#ffffff"
                android:id="@+id/confirm"
                android:background="@drawable/bg_button_main_blue"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="48dp"
                android:layout_marginRight="24dp"
                android:text="确定"
                android:layout_below="@+id/new_password"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
