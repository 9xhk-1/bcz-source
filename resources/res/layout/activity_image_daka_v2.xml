<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_image_daka_v2_0"
    android:background="@color/main_color_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/action_bar_close"
        android:background="@color/main_color_white"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/button_action_bar_dark_close"
        android:scaleType="centerInside"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/action_bar_more"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_action_bar_info"
        android:scaleType="centerInside"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/main_color_common_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_close"/>
    <View
        android:background="@drawable/bg_gradient_white_to_trans_270"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_close"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/image_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toTopOf="@+id/pager_tab"
        app:layout_constraintTop_toBottomOf="@+id/action_bar_close"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.baicizhan.main.customview.PageLineDotIndicator
        android:id="@+id/pager_tab"
        android:background="@android:color/transparent"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/share_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_pager"
        app:tabGravity="fill"
        app:tabIndicator="@null"
        app:tabRippleColor="@android:color/transparent"/>
    <com.baicizhan.client.business.widget.share.SharePanelViewV2
        android:id="@+id/share_panel"
        android:tag="binding_1"
        android:background="@color/main_color_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="image_pager,pager_tab,share_panel"/>
    <include layout="@layout/daka_loading_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
