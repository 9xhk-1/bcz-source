<?xml version="1.0" encoding="utf-8"?>
<com.baicizhan.main.customview.FrameLayoutAutoSizeFix xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="@color/main_color_weak_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.baicizhan.main.customview.PatternContainer
        android:orientation="vertical"
        android:id="@+id/learning_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <LinearLayout
                android:layout_width="116dp"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/home"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:src="@drawable/ic_action_bar_back_old"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/main_color_word_b8"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/new_count"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:text="需新学\10需复习"/>
            </LinearLayout>
            <View
                android:background="@color/main_color_weak_divider"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_color_word_b8"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/last_topic"
                android:paddingLeft="16dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:drawablePadding="12dp"
                android:layout_weight="2"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/example_placeholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/fullscreen_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/learning_footer"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="@dimen/learning_footer_bottom_margin"
            android:layout_alignParentBottom="true">
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/kill"
                android:background="@drawable/button_study_bottom_bar"
                android:layout_width="85dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_study_slash"
                android:scaleType="centerInside"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/hint"
                android:background="@drawable/button_study_bottom_bar"
                android:layout_width="85dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_study_hint"
                android:scaleType="centerInside"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <ImageView
                android:gravity="center"
                android:id="@+id/voice"
                android:background="@drawable/button_study_bottom_bar"
                android:layout_width="85dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_study_sound_3"
                android:scaleType="centerInside"/>
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
    </com.baicizhan.main.customview.PatternContainer>
    <RelativeLayout
        android:id="@+id/progress_layout"
        android:background="#99434343"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="bottom"
            android:id="@+id/loading_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_alignParentBottom="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="@dimen/T3"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/cancel_loading"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消加载"
            android:layout_above="@+id/loading_progress"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.baicizhan.client.business.widget.SwipeViewPager
        android:id="@+id/wiki_pager"
        android:background="@android:color/transparent"
        android:visibility="invisible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="#00000000"
        android:divider="@null"/>
</com.baicizhan.main.customview.FrameLayoutAutoSizeFix>
