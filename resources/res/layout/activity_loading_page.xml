<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/copy_root_progress_wrap"
        android:paddingTop="60dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ProgressBar
            android:id="@+id/copy_root_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:max="1000"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="@dimen/T2"
            android:textColor="@color/C19"
            android:gravity="center"
            android:id="@+id/copy_root_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/toast_loading_copy_root_progress_tip"/>
    </LinearLayout>
    <View
        android:id="@+id/ad_click_rect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageButton
        android:id="@+id/close"
        android:background="#00000000"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/share_close_default"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/third_ad"
        android:visibility="gone"
        android:inflatedId="@layout/activity_audio_center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/third_ad_containner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/thrid_exit_button"
                android:background="@drawable/btn_ad_skip_normal"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="48dp"
                android:minWidth="73dp"
                android:minHeight="36dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ad_click_text"
                android:background="@drawable/bg_splash_click_rect"
                android:paddingLeft="24dp"
                android:paddingTop="12dp"
                android:paddingRight="24dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginBottom="64dp"
                android:text="点击跳转详情页或第三方应用"
                android:drawableRight="@drawable/ic_splash_ad_arrow"
                android:drawablePadding="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white_color"
                android:gravity="center"
                android:id="@+id/splash_ad_mark"
                android:background="@drawable/bg_text_splash_ad"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="广告"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ad_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="53dp">
            <androidx.legacy.widget.Space
                android:id="@+id/extra_padding_top"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/extra_padding_top">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/logo"
                    android:layout_width="wrap_content"
                    android:layout_height="70dp"
                    android:scaleType="centerInside"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_copyright"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_splash_bottom_s"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/slogan_of_s"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_slogan_s"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name"/>
</RelativeLayout>
