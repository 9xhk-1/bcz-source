<?xml version="1.0" encoding="utf-8"?>
<com.flipboard.bottomsheet.BottomSheetLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomsheet"
    android:tag="layout/activity_lookup_word_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lookup_content_root"
        android:background="@color/main_color_weak_bg"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
            android:id="@+id/top_bar"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/camera_img"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dark_camera"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/main_color_black"
                android:gravity="center"
                android:id="@+id/cancel_lookup"
                android:background="?attr/actionBarItemBackground"
                android:paddingLeft="16dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/cancel"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <View
                android:id="@+id/lookup_edit_bg"
                android:background="@drawable/white_rounded_bg"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_toLeftOf="@+id/cancel_lookup"
                android:layout_toRightOf="@+id/camera_img"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/main_color_main_word"
                android:textColorHint="@color/main_color_word_b8"
                android:id="@+id/lookup_edit"
                android:background="@android:color/transparent"
                android:paddingRight="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="11dp"
                android:hint="请输入要查询的英文或中文"
                android:singleLine="true"
                android:drawableLeft="@drawable/ic_search_16_16"
                android:drawablePadding="8dp"
                android:layout_toLeftOf="@+id/cancel_lookup"
                android:layout_alignLeft="@+id/lookup_edit_bg"
                android:layout_centerVertical="true"
                android:imeOptions="actionSearch"/>
            <ImageView
                android:id="@+id/lookup_clear"
                android:background="?attr/actionBarItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_input_clear_normal_default"
                android:layout_toLeftOf="@+id/cancel_lookup"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/main_color_main_word"
                android:id="@+id/lookup_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/searchwords_nothing_img_normal_default"
                android:drawablePadding="20dp"
                android:layout_centerInParent="true"/>
            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ProgressBar
                android:id="@+id/lookup_progress"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:indeterminateOnly="true"
                style="?android:attr/progressBarStyleHorizontal"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/drag_highlight"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:foreground="@drawable/fg_drag_area_highlight"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/camera_tip"
            android:background="@drawable/bg_new_tip_pop"
            android:paddingLeft="12dp"
            android:paddingTop="14dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:paddingHorizontal="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_new_tip"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/main_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点这里，试试拍照查词"
                android:maxLines="1"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/tip_close"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_close_white"
                android:scaleType="centerInside"
                android:layout_marginStart="11dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.flipboard.bottomsheet.BottomSheetLayout>
