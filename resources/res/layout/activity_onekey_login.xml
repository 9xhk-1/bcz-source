<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_container"
    android:tag="layout/activity_onekey_login_0"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_basic"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_line_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="20dp"/>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:id="@+id/noproguard_title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_word_7e"
        android:id="@+id/noproguard_desc"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_right"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/service_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="noproguard_title,noproguard_desc"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/carrier_service_desc"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_right"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left"
        app:layout_constraintTop_toBottomOf="@+id/service_barrier"/>
    <TextView
        android:textSize="32dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/noproguard_secure_phone"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_right"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left"
        app:layout_constraintTop_toBottomOf="@+id/carrier_service_desc"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_7e"
        android:gravity="center"
        android:id="@+id/noproguard_tip"
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="4dp"
        android:text="@string/sec_verify_unregistered_tip"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_right"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_secure_phone"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/phone_tip_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="noproguard_secure_phone,noproguard_tip"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/verify"
        android:tag="binding_6"
        android:background="@drawable/bg_button_main_blue"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_right"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left"
        app:layout_constraintTop_toBottomOf="@+id/phone_tip_barrier"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_blue_color"
        android:gravity="center"
        android:id="@+id/other_way"
        android:tag="binding_7"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_right"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left"
        app:layout_constraintTop_toBottomOf="@+id/verify"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/agreement_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guide_line_right"
        app:layout_constraintStart_toStartOf="@+id/guide_line_left">
        <ImageView
            android:id="@+id/protocol_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_primary_checkbox"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/main_color_word_b8"
            android:gravity="center"
            android:id="@+id/agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/weibo_mail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"
        app:layout_constraintGuide_percent="0.5"/>
    <FrameLayout
        android:id="@+id/weibo_btn"
        android:tag="binding_8"
        android:background="@drawable/bg_weibo_or_mail_login"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/agreement_layout"
        app:layout_constraintEnd_toStartOf="@+id/weibo_mail">
        <TextView
            android:textSize="14dp"
            android:textColor="#283044"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="微博账号登录"
            android:drawableLeft="@drawable/ic_weibo"
            android:drawablePadding="8dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/mail_btn"
        android:tag="binding_9"
        android:background="@drawable/bg_weibo_or_mail_login"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/agreement_layout"
        app:layout_constraintStart_toStartOf="@+id/weibo_mail">
        <TextView
            android:textSize="14dp"
            android:textColor="#283044"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_mail_title"
            android:drawableLeft="@drawable/ic_mail"
            android:drawablePadding="8dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
