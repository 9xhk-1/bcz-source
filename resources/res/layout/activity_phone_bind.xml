<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_phone_bind_0"
    android:background="@color/main_color_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_basic"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/main_color_black"
        android:id="@+id/title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_black"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description">
        <com.baicizhan.main.customview.CountDownButton
            android:enabled="false"
            android:textSize="13dp"
            android:textColor="@color/main_color_blue_light"
            android:id="@+id/get_auth_code"
            android:background="#00000000"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:text="@string/send_num"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/phone_clear"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_input_clear_normal_default"
            android:scaleType="centerInside"
            android:layout_toLeftOf="@+id/get_auth_code"/>
        <EditText
            android:textSize="17dp"
            android:textColor="@color/main_color_main_word"
            android:textColorHint="@color/main_color_word_b8"
            android:gravity="center_vertical"
            android:id="@+id/phone"
            android:tag="binding_2"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="24dp"
            android:maxEms="30"
            android:singleLine="true"
            android:maxLength="15"
            android:layout_toLeftOf="@+id/phone_clear"
            android:inputType="phone"
            android:imeOptions="flagNoExtractUi"
            android:textCursorDrawable="@null"/>
        <View
            android:background="@color/main_color_strong_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_below="@+id/phone"/>
        <EditText
            android:textSize="17dp"
            android:textColor="@color/main_color_main_word"
            android:textColorHint="@color/main_color_word_b8"
            android:gravity="bottom"
            android:id="@+id/auth_code"
            android:background="#00000000"
            android:paddingRight="38dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:hint="短信验证码"
            android:singleLine="true"
            android:maxLength="50"
            android:layout_below="@+id/phone"
            android:inputType="number"/>
        <View
            android:background="@color/main_color_strong_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="59dp"
            android:layout_marginRight="24dp"
            android:layout_below="@+id/phone"/>
        <ImageView
            android:id="@+id/auth_code_clear"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/ic_input_clear_normal_default"
            android:scaleType="centerInside"
            android:layout_below="@+id/phone"
            android:layout_alignParentRight="true"/>
        <RelativeLayout
            android:id="@+id/password_container"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_below="@+id/auth_code">
            <ImageView
                android:id="@+id/see"
                android:background="?attr/actionBarItemBackground"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/password_btn_hide_normal_default"
                android:scaleType="centerInside"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/password_clear"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_input_clear_normal_default"
                android:scaleType="centerInside"
                android:layout_toLeftOf="@+id/see"/>
            <EditText
                android:textSize="17dp"
                android:textColor="@color/main_color_main_word"
                android:textColorHint="@color/main_color_word_b8"
                android:gravity="bottom"
                android:id="@+id/password"
                android:tag="binding_3"
                android:background="@android:color/transparent"
                android:paddingRight="15dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:singleLine="true"
                android:maxLength="50"
                android:layout_toLeftOf="@+id/password_clear"
                android:inputType="textPassword"/>
            <View
                android:background="@color/main_color_strong_divider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="59dp"
                android:layout_alignParentTop="true"/>
        </RelativeLayout>
        <Button
            android:enabled="false"
            android:textSize="17sp"
            android:textColor="#ffffff"
            android:id="@+id/bind"
            android:tag="binding_4"
            android:background="@drawable/bg_button_main_blue"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="24dp"
            android:layout_below="@+id/password_container"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
