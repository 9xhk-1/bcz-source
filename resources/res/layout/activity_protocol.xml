<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/main_color_white"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/logo"
        android:layout_width="54dp"
        android:layout_height="64dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="71dp"
        android:src="@drawable/ic_round_app_logo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/main_color_black"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/protocol_welcome"
        app:layout_constraintLeft_toRightOf="@+id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/main_color_black"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/protocol_baicizhan"
        android:letterSpacing="0.08"
        app:layout_constraintBottom_toBottomOf="@+id/logo"
        app:layout_constraintLeft_toRightOf="@+id/logo"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <View
        android:id="@+id/divider"
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="32dp"
        app:layout_constraintTop_toBottomOf="@+id/logo"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/refuse"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/main_color_main_word"
            android:id="@+id/protocol_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/protocol_content"
            android:lineSpacingExtra="5dp"/>
    </androidx.core.widget.NestedScrollView>
    <View
        android:background="@drawable/bg_gradient_from_white_to_trans"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/scrollview"
        app:layout_constraintLeft_toLeftOf="@+id/scrollview"
        app:layout_constraintRight_toRightOf="@+id/scrollview"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/refuse"
        android:background="@drawable/bcz_dialog_button_common"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="24dp"
        android:text="@string/protocol_reject"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/confirm"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_white"
        android:gravity="center"
        android:id="@+id/confirm"
        android:background="@drawable/bcz_dialog_button_positive"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="24dp"
        android:text="@string/protocol_agree"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/refuse"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
