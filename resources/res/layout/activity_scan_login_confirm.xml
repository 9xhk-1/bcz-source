<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:tag="layout/activity_scan_login_confirm_0"
    android:background="#ffffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:tag="binding_1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_scan_watch_login_close"
            android:layout_marginStart="10dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/image_watch"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/ic_scan_watch_login_watch"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ff283044"
        android:id="@+id/title_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/scan_watch_login_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_watch"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff283044"
        android:id="@+id/sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/scan_watch_login_confirm"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_main"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff9ca6b8"
        android:gravity="center"
        android:id="@+id/cancel_btn"
        android:tag="binding_2"
        android:layout_width="255dp"
        android:layout_height="44dp"
        android:layout_marginBottom="60dp"
        android:text="@string/scan_watch_login_button_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:tag="binding_3"
        android:background="@drawable/scan_login_watch_confirm_bg"
        android:layout_width="255dp"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:text="@string/scan_watch_login_button_confirm"
        app:layout_constraintBottom_toTopOf="@+id/cancel_btn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
