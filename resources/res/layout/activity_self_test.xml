<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_color_weak_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <LinearLayout
                android:layout_width="116dp"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/home"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:src="@drawable/ic_action_bar_back_old"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/main_color_word_b8"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/words_left"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:text="需复习"/>
            </LinearLayout>
            <View
                android:background="@color/main_color_weak_divider"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/main_color_word_b8"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/last_topic"
                android:paddingLeft="16dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:drawablePadding="12dp"
                android:layout_weight="2"/>
        </LinearLayout>
        <com.baicizhan.client.business.widget.DirectionalViewPager
            android:orientation="vertical"
            android:id="@+id/words_gallery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="65dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="100dp"/>
        <LinearLayout
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true">
            <FrameLayout
                android:background="@drawable/bg_study_option_shadow"
                android:padding="6dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/main_color_main_word"
                    android:gravity="center"
                    android:id="@+id/forget_the_word_btn"
                    android:background="@drawable/button_study_word_option"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/forget_the_word"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/bg_study_option_shadow"
                android:padding="6dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/main_color_main_word"
                    android:gravity="center"
                    android:id="@+id/remember_the_word_btn"
                    android:background="@drawable/button_study_word_option"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/remember_the_word"/>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
