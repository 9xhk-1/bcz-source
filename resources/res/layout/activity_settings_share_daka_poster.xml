<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/C120"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        android:id="@+id/app_bar"
        android:background="@color/C120"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/back"
                android:background="?attr/actionBarItemBackground"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_ab_back"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:id="@android:id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打卡样式"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:background="#fff4f5f6"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp">
        <include
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"
            layout="@layout/setting_share_item_daka_poster"/>
        <include
            android:id="@+id/classic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/poster"
            android:layout_centerHorizontal="true"
            layout="@layout/setting_share_item_daka_classic"/>
        <Button
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:id="@+id/setting_daka"
            android:background="@drawable/button_share_confirm"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="31dp"
            android:text="@string/share_mode_setting_and_daka"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff999999"
            android:gravity="center"
            android:id="@+id/setting_daka_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/share_mode_hint"
            android:layout_above="@+id/setting_daka"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
