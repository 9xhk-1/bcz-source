<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content"
    android:background="#ff000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/video_view_container"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <com.baicizhan.client.business.widget.FullscreenVideoLayout
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:orientation="vertical"
        android:id="@+id/title_bar"
        android:background="@drawable/action_bar_gradient_bg"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="51dp">
        <ImageView
            android:id="@+id/home"
            android:background="?attr/actionBarItemBackground"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_action_bar_back_light_old"
            android:scaleType="centerInside"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <FrameLayout
        android:background="@color/C57"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/video_view_container">
        <com.baicizhan.client.business.widget.RoundedButton
            android:textSize="19dp"
            android:textColor="#ffc0c0c0"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/empty_view"
            android:layout_width="125dp"
            android:layout_height="51dp"
            android:layout_marginTop="32dp"
            android:text="重新加载"
            app:cornerRadius="11dp"
            app:strokeColor="#ffc0c0c0"
            app:strokeWidth="1px"/>
        <WebView
            android:id="@+id/board_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</RelativeLayout>
