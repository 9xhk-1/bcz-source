<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_user_edit_0"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_basic"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/edit_name"
        android:tag="binding_1"
        android:background="@drawable/edit_user_name_bg"
        android:paddingLeft="12dp"
        android:paddingRight="48dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="20dp"
        android:singleLine="true"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <ImageView
        android:tag="binding_2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_input_clear_normal_default"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/edit_name"
        app:layout_constraintRight_toRightOf="@+id/edit_name"
        app:layout_constraintTop_toTopOf="@+id/edit_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_word_7e"
        android:id="@+id/desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/edit_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
