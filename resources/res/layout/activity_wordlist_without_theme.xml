<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_wordlist_without_theme_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/book_info_area"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/bg_cover"
            android:background="@color/main_color_main_word"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/bg_cover_front"
            android:background="@color/main_color_main_word"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/action_bar"
            layout="@layout/action_bar_basic"/>
        <com.baicizhan.main.view.AspectRoundImageView
            android:id="@+id/book_cover"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_book_cover_default"
            android:scaleType="fitXY"
            android:layout_marginStart="20dp"
            app:aspectRatio="0.75"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/action_bar"
            app:riv_corner_radius="2dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@android:color/white"
            android:id="@+id/book_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/book_cover"
            app:layout_constraintTop_toTopOf="@+id/book_cover"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#99ffffff"
            android:ellipsize="end"
            android:id="@+id/book_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lines="2"
            android:lineSpacingExtra="6dp"
            app:layout_constraintEnd_toEndOf="@+id/book_summary"
            app:layout_constraintStart_toStartOf="@+id/book_summary"
            app:layout_constraintTop_toBottomOf="@+id/book_summary"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="right"
            android:id="@+id/book_link"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:drawableRight="@drawable/ic_common_arrow_right"
            android:drawablePadding="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/book_cover"
            app:layout_constraintEnd_toEndOf="@+id/book_summary"
            app:layout_constraintStart_toEndOf="@+id/book_download"/>
        <com.baicizhan.main.customview.OfflineDownloadView
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/book_download"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/book_summary"
            app:tintedColor="@android:color/white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.baicizhan.main.customview.WordListNavigation
        android:id="@+id/navigator"
        android:background="@color/main_color_white"
        android:layout_width="match_parent"
        android:layout_height="37.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/book_info_area"/>
    <View
        android:id="@+id/bg_bottom_area"
        android:background="@color/main_color_weak_bg"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigator"/>
    <RelativeLayout
        android:id="@+id/wordlist_edit_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wordlist_header_height"
        android:baselineAligned="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigator">
        <com.baicizhan.client.business.widget.RoundedButton
            android:textSize="12sp"
            android:textColor="@color/main_color_main_word"
            android:gravity="center"
            android:id="@+id/edit"
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:layout_marginRight="15dp"
            android:text="@string/word_list_edit"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"
            app:cornerRadius="2dp"/>
        <com.baicizhan.client.business.widget.RoundedButton
            android:textSize="12sp"
            android:textColor="@color/main_color_main_word"
            android:gravity="center"
            android:id="@+id/sort"
            android:layout_width="68dp"
            android:layout_height="24dp"
            android:layout_marginRight="10dp"
            android:text="@string/word_list_sort_time_desc"
            android:layout_toLeftOf="@+id/edit"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/edit"
            app:cornerRadius="2dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/main_color_word_b8"
            android:gravity="center"
            android:id="@+id/word_count_header"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginStart="15dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/main_color_blue_dark"
            android:gravity="center"
            android:id="@+id/collect_word_review"
            android:background="@drawable/bg_button_collect_word_review"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="10dp"
            android:text="@string/word_list_study"
            android:layout_toLeftOf="@+id/sort"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/sort"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wordlist_edit_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
