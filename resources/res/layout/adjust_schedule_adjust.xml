<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/adjust_schedule_adjust_0"
    android:background="@color/main_color_white"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/book_bg"
        android:layout_width="72dp"
        android:layout_height="96dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_main_word"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintLeft_toRightOf="@+id/book_bg"
        app:layout_constraintRight_toLeftOf="@+id/reset"
        app:layout_constraintTop_toTopOf="@+id/book_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:text="@string/schedule_confirm_reset"
        android:drawableLeft="@drawable/ic_schedule_reset"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/book_bg"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/main_color_white"
        android:id="@+id/review_round"
        android:background="@drawable/bg_adjust_schedule_review_round"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/book_name"
        app:layout_constraintTop_toBottomOf="@+id/book_name"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/book_finish_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/book_name"
        app:layout_constraintTop_toBottomOf="@+id/review_round"/>
    <ProgressBar
        android:id="@+id/plan_progress_bar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:layout_marginEnd="20dp"
        android:progressTint="@color/primary_blue_200"
        android:backgroundTint="#66e6e9ee"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/book_name"
        app:layout_constraintTop_toBottomOf="@+id/book_finish_tips"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ProgressBar
        android:id="@+id/plan_progress_bar_masted"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:layout_marginEnd="20dp"
        android:progressTint="@color/main_color_blue_dark"
        android:backgroundTint="@color/main_color_blue_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/book_name"
        app:layout_constraintTop_toBottomOf="@+id/book_finish_tips"
        style="?android:attr/progressBarStyleHorizontal"/>
    <View
        android:id="@+id/plan_progress_bar_masted_dot"
        android:background="@drawable/ic_book_master_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_master_desc"
        app:layout_constraintStart_toStartOf="@+id/plan_progress_bar"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_master_desc"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_master_desc"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="已学单词"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/plan_progress_bar_masted_dot"
        app:layout_constraintTop_toBottomOf="@+id/plan_progress_bar"/>
    <View
        android:id="@+id/plan_progress_bar_learned_dot"
        android:background="@drawable/ic_book_learned_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_learned_desc"
        app:layout_constraintStart_toEndOf="@+id/wp_plan_master_desc"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_learned_desc"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_learned_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="已学单词"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/plan_progress_bar_learned_dot"
        app:layout_constraintTop_toBottomOf="@+id/plan_progress_bar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_progress_value"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_learned_desc"
        app:layout_constraintEnd_toEndOf="@+id/plan_progress_bar"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_learned_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
