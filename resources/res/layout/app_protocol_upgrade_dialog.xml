<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:clipToPadding="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shape="rectangle"
        app:cardCornerRadius="4dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/main_color_main_word"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/app_protocol_upgrade_title_dialog"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/content_area"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@+id/title">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/main_color_main_word"
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/protocol_content"
                    android:lineSpacingExtra="5dp"/>
            </androidx.core.widget.NestedScrollView>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/main_color_main_word"
                android:gravity="center"
                android:id="@+id/refuse"
                android:background="@drawable/bcz_dialog_button_common"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="6dp"
                android:text="@string/protocol_dialog_reject"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/confirm"
                app:layout_constraintTop_toBottomOf="@+id/content_area"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/main_color_white"
                android:gravity="center"
                android:id="@+id/confirm"
                android:background="@drawable/bcz_dialog_button_positive"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="16dp"
                android:text="@string/protocol_dialog_agree"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintLeft_toRightOf="@+id/refuse"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
