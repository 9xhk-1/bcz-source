<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/bcz_dialog_base_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:clipToPadding="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shape="rectangle"
        app:cardCornerRadius="4dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="#ffffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="303dp">
            <ImageView
                android:id="@+id/title_img"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:minHeight="8dp"/>
            <View
                android:id="@+id/img_padding"
                android:layout_width="1dp"
                android:layout_height="8dp"/>
            <FrameLayout
                android:id="@+id/title_container"
                android:paddingTop="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/bczDialog_titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:maxLines="2"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="@style/bczDialogTitle"/>
            </FrameLayout>
            <FrameLayout
                android:gravity="center"
                android:id="@+id/bczDialog_contentView"
                android:paddingTop="16dp"
                android:paddingBottom="32dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:minWidth="254dp"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/button_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/close"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:src="@drawable/bcz_dialog_closed_bt"/>
</LinearLayout>
