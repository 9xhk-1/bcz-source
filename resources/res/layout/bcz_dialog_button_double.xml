<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:tag="layout/bcz_dialog_button_double_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#ff202224"
        android:id="@+id/bottom_left"
        android:background="@drawable/bcz_dialog_button_common"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="9.5dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="9.5dp"
        style="@style/bczDialogButtonCommon"/>
    <TextView
        android:textColor="#ffffffff"
        android:id="@+id/bottom_right"
        android:background="@drawable/bcz_dialog_button_positive"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="9.5dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:layout_marginStart="9.5dp"
        android:layout_marginEnd="24dp"
        style="@style/bczDialogButtonCommon"/>
</LinearLayout>
