<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/bcz_dialog_button_triple_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#ffffffff"
        android:id="@+id/bottom_top"
        android:background="@drawable/bcz_dialog_button_positive"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="12dp"
        style="@style/bczDialogButtonCommon"/>
    <TextView
        android:textColor="#ff202224"
        android:id="@+id/bottom_middle"
        android:background="@drawable/bcz_dialog_button_common"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="12dp"
        style="@style/bczDialogButtonCommon"/>
    <TextView
        android:textColor="#ff202224"
        android:id="@+id/bottom_bottom"
        android:background="@drawable/bcz_dialog_button_common"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="24dp"
        style="@style/bczDialogButtonCommon"/>
</LinearLayout>
