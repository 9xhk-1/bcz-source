<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/bcz_loading_view_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:id="@+id/progress"
        android:tag="binding_2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="#ff000000"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_word_b8"
        android:gravity="center"
        android:id="@+id/text"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="8dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/retry"
        android:tag="binding_4"
        android:background="@drawable/base_loading_button"
        android:layout_width="255dp"
        android:layout_height="40dp"
        android:layout_marginTop="104dp"
        android:text="@string/base_loading_view_retry"/>
</LinearLayout>
