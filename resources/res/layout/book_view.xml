<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="165dp">
    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="8dp"
            android:textColor="?attr/color_common_white"
            android:layout_gravity="bottom"
            android:id="@+id/play_time"
            android:background="#33000000"
            android:paddingLeft="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/readingplan_earphone_normal_default"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="?attr/color_topbar_text2"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_below="@+id/image_container"
        android:layout_alignLeft="@+id/image_container"
        android:layout_alignRight="@+id/image_container"/>
    <TextView
        android:textSize="10dp"
        android:textColor="?attr/color_topbar_text2"
        android:id="@+id/level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/name"
        android:layout_alignLeft="@+id/image_container"
        android:layout_alignRight="@+id/image_container"/>
</RelativeLayout>
