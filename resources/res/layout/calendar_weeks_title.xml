<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/weeks_title"
    android:paddingTop="8dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="7">
    <TextView
        android:textSize="@dimen/T8"
        android:gravity="center"
        android:id="@+id/week_title_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="MON"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/T8"
        android:gravity="center"
        android:id="@+id/week_title_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="TUE"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/T8"
        android:gravity="center"
        android:id="@+id/week_title_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="WED"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/T8"
        android:gravity="center"
        android:id="@+id/week_title_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="THU"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/T8"
        android:gravity="center"
        android:id="@+id/week_title_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="FRI"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/T8"
        android:gravity="center"
        android:id="@+id/week_title_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SAT"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/T8"
        android:gravity="center"
        android:id="@+id/week_title_7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SUN"
        android:layout_weight="1"/>
</LinearLayout>
