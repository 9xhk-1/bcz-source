<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/window"
        android:background="?attr/drawable_line_wiki"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/T3"
            android:textColor="?attr/color_fm_firstcard"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="我想说..."
            android:layout_centerHorizontal="true"/>
        <com.baicizhan.client.business.widget.DisableMultilineIMEEditText
            android:textSize="@dimen/T2"
            android:textColor="?attr/color_type_text"
            android:textColorHint="?attr/color_type_text"
            android:gravity="top"
            android:id="@+id/edit"
            android:background="?attr/drawable_bg_text"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="48dp"
            android:hint="说点啥呢..."
            android:layout_below="@+id/title"
            android:imeOptions="actionSend"/>
        <TextView
            android:textSize="@dimen/T2"
            android:textColor="?attr/color_button_text"
            android:gravity="center"
            android:id="@+id/submit"
            android:layout_width="85dp"
            android:layout_height="28dp"
            android:layout_marginBottom="10dp"
            android:text="发送"
            android:layout_alignRight="@+id/edit"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="@dimen/T2"
            android:textColor="?attr/color_button_text"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="?attr/drawable_button_line"
            android:layout_width="85dp"
            android:layout_height="28dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="10dp"
            android:text="@string/cancel"
            android:layout_alignLeft="@+id/edit"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
