<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_repair_daka_0"
    android:background="@drawable/bg_calendar_repair_dialog"
    android:layout_width="match_parent"
    android:layout_height="318dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_guide"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="24dp"/>
    <ImageView
        android:id="@+id/repair_image"
        android:background="#66e6e9ee"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerInside"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_word_822"
        android:gravity="left"
        android:id="@+id/repair_title"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toRightOf="@+id/repair_image"
        app:layout_constraintTop_toTopOf="@+id/repair_image"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#9ca6b8"
        android:id="@+id/repair_num"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/repair_title"
        app:layout_constraintTop_toBottomOf="@+id/repair_title"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ff5724"
        android:id="@+id/repair_copper_num"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="@+id/repair_title"
        app:layout_constraintTop_toBottomOf="@+id/repair_num"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:ellipsize="end"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_repair_daka_desc"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="@+id/repair_copper_num"
        app:layout_constraintRight_toLeftOf="@+id/expand_collapse"
        app:layout_constraintTop_toBottomOf="@+id/repair_copper_num"/>
    <ImageView
        android:id="@+id/expand_collapse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:src="@drawable/ic_dialog_desc_down"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/desc"/>
    <View
        android:id="@+id/repair_gray_line"
        android:background="#66e6e9ee"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/desc"/>
    <ImageView
        android:id="@+id/repair_cooper_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_repair_copper"
        android:scaleType="centerInside"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/repair_gray_line"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#6067ae"
        android:id="@+id/repair_user_cooper_num"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toRightOf="@+id/repair_cooper_image"
        app:layout_constraintTop_toTopOf="@+id/repair_cooper_image"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#124ee6"
        android:gravity="center"
        android:id="@+id/repair_cancel"
        android:background="@drawable/bg_repair_dialog_negative_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="50dp"
        android:text="取消"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/repair_confirm"
        app:layout_constraintTop_toBottomOf="@+id/repair_user_cooper_num"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/repair_confirm"
        android:background="@drawable/bg_calendar_repair_btn"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="50dp"
        android:text="确认兑换"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="16dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/repair_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/repair_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
