<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_repair_daka_result_0"
    android:background="@drawable/bg_calendar_repair_dialog"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="318dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_guide"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="24dp"/>
    <ImageView
        android:id="@+id/repair_result_img"
        android:tag="binding_1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="53dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#000000"
        android:id="@+id/repair_result_text"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/repair_result_img"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#283044"
        android:gravity="center"
        android:id="@+id/repair_finish"
        android:tag="binding_3"
        android:background="@drawable/bg_round_66e6e9ee_6dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="57dp"
        android:layout_marginBottom="50dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/repair_more"
        app:layout_constraintTop_toBottomOf="@+id/repair_result_text"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/repair_more"
        android:tag="binding_4"
        android:background="@drawable/bg_round_283044_6dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginLeft="11dp"
        android:layout_marginBottom="50dp"
        android:text="获取铜板"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/repair_finish"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/repair_finish"/>
</androidx.constraintlayout.widget.ConstraintLayout>
