<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_white_small_corner"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fm_word_card_height">
    <ImageButton
        android:id="@+id/fm_end_listen_more"
        android:background="#00000000"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="@dimen/T2"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/fm_line_review"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/fm_review_more"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/T4"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:layout_width="132dp"
        android:layout_height="wrap_content"
        android:text="@string/fm_review_more_info"
        android:layout_centerInParent="true"
        android:lineSpacingExtra="6dp"/>
</RelativeLayout>
