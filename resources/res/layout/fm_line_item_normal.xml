<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_white_small_corner"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fm_word_card_height">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:ellipsize="end"
        android:id="@+id/fm_line_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_7e"
        android:id="@+id/fm_line_cnmean"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/fm_line_word"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_main_word"
        android:ellipsize="end"
        android:id="@+id/fm_line_example"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="5"
        android:layout_below="@+id/fm_line_cnmean"/>
    <RelativeLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fm_line_example">
        <Button
            android:textSize="@dimen/T2"
            android:textColor="?attr/color_button_oval"
            android:id="@+id/fm_line_send_err"
            android:background="#00000000"
            android:layout_width="70dp"
            android:layout_height="20dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/fm_send_err"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/T3"
        android:textColor="?attr/color_button_oval"
        android:gravity="center"
        android:id="@+id/fm_line_retry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        android:text="@string/fm_retry"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ProgressBar
        android:id="@+id/retry_progress"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/Widget.AppCompat.ProgressBar"/>
</RelativeLayout>
