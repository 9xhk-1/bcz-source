<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_about_us_v2_0"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:src="@drawable/aboutus_img_normal_default"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/debug1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toStartOf="@+id/image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <View
        android:id="@+id/debug2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image"
        app:layout_constraintTop_toTopOf="@+id/image"/>
    <View
        android:id="@+id/divider_1"
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toTopOf="@+id/protocol"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider_preference"
            android:showDividers="end|middle">
            <com.baicizhan.main.view.PreferenceView
                android:id="@+id/current_version"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:preferenceTitle="@string/about_us_version"/>
            <com.baicizhan.main.view.PreferenceView
                android:id="@+id/version_update"
                android:tag="binding_2"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:preferenceStateIcon="@drawable/ic_word_plan_arrow_right"
                app:preferenceStateIconTint="@color/main_color_word_b8"
                app:preferenceTitle="@string/about_us_version_update"/>
            <com.baicizhan.main.view.PreferenceView
                android:id="@+id/feedback_phone"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:preferenceDescSize="12dp"
                app:preferenceTitle="@string/about_us_feedback_phone"/>
            <com.baicizhan.main.view.PreferenceView
                android:id="@+id/feedback_email"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:preferenceDescSize="12dp"
                app:preferenceTitle="@string/about_us_feedback_email"/>
            <com.baicizhan.main.view.PreferenceView
                android:id="@+id/join_us"
                android:tag="binding_5"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:preferenceStateIcon="@drawable/ic_word_plan_arrow_right"
                app:preferenceStateIconTint="@color/main_color_word_b8"
                app:preferenceTitle="@string/about_us_join_us"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_hint"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/protocol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/icp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_822"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/icp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/about_us_icp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
