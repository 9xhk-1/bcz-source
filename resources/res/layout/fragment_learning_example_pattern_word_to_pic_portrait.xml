<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/pattern_word"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        app:layout_constraintBottom_toTopOf="@+id/option_container"
        app:layout_constraintLeft_toLeftOf="@+id/option_container"
        app:layout_constraintRight_toRightOf="@+id/option_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1"
        layout="@layout/pattern_word_to_pic_subject"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/recall_switch_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/recall_switch_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_visible"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_04"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="回忆模式"/>
    </LinearLayout>
    <include
        android:id="@+id/option_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="wrap"
        app:layout_constraintHeight_percent="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_max="520dp"
        layout="@layout/pattern_word_to_pic_options"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/recall_layout"
        android:paddingBottom="88dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/gray_03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="回忆单词中文意思，再答题验证"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/main_color_blue_dark"
            android:gravity="center"
            android:id="@+id/answer_verify_btn"
            android:background="@drawable/bg_round_e7edfc_6dp_selector"
            android:layout_width="276dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="答题验证"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
