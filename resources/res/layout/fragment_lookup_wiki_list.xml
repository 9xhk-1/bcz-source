<?xml version="1.0" encoding="utf-8"?>
<com.flipboard.bottomsheet.BottomSheetLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomsheet"
    android:tag="layout/fragment_lookup_wiki_list_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/content"
        android:tag="binding_1"
        android:background="@color/main_color_weak_bg"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/loadmore"
            android:tag="binding_2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"
            style="@style/ThemeProgressbar"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wiki_list"
            android:tag="binding_3"
            android:scrollbars="vertical"
            android:saveEnabled="false"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="54dp"
            layout="@layout/lookup_wiki_error_msg"/>
        <View
            android:tag="binding_4"
            android:background="@color/main_color_weak_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginBottom="72dp"
            android:layout_alignParentBottom="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottom_bar"
            android:tag="binding_5"
            android:background="@color/main_color_white"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_alignParentBottom="true">
            <ImageView
                android:id="@+id/kill"
                android:tag="binding_6"
                android:background="@drawable/button_study_bottom_bar"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:layout_marginRight="16dp"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/main_color_blue_dark"
                android:gravity="center"
                android:id="@+id/continue_learn"
                android:tag="binding_7"
                android:background="@drawable/button_study_wiki_blue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="继续做题"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/main_color_blue_dark"
                android:gravity="center"
                android:id="@+id/back_to_main"
                android:tag="binding_8"
                android:background="@drawable/button_study_wiki_blue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="返回"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_9"
            android:background="@color/main_color_white"
            android:paddingLeft="20dp"
            android:paddingTop="12dp"
            android:paddingRight="20dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/main_color_blue_dark"
                android:gravity="center"
                android:tag="binding_10"
                android:background="@drawable/button_study_wiki_blue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="返回"/>
        </LinearLayout>
    </RelativeLayout>
</com.flipboard.bottomsheet.BottomSheetLayout>
