<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_lookup_wiki_v2_0"
    android:background="#f8f8f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/loading_progress"
        android:tag="binding_1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="#ff000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/error_state_container"
        android:tag="binding_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/fragment_wiki_error_state"/>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:background="#f8f8f9"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_container"
            android:background="#f8f8f9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/word_info_container"
                android:background="#f8f8f9"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="32dp"
                    android:textStyle="bold"
                    android:textColor="@color/main_color_main_word"
                    android:gravity="center_vertical"
                    android:id="@+id/word"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="64dp"
                    app:autoSizeMaxTextSize="32dp"
                    app:autoSizeMinTextSize="10dp"
                    app:autoSizeTextType="uniform"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/collect"
                    android:layout_width="24dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_word_collect"
                    android:scaleType="center"
                    app:layout_constraintBottom_toBottomOf="@+id/word"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/word"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/phonetic_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/word"
                    app:layout_constraintTop_toBottomOf="@+id/word">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/main_color_main_word"
                        android:gravity="center_vertical"
                        android:id="@+id/phonetic_us"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="24dp"/>
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/voice_us"
                        android:paddingRight="24dp"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/anim_audio_speaker"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/main_color_main_word"
                        android:gravity="center_vertical"
                        android:id="@+id/phonetic_uk"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="24dp"
                        android:layout_marginStart="16dp"/>
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/voice_uk"
                        android:paddingRight="24dp"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/anim_audio_speaker"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/meanings_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/phonetic_container"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/main_color_word_b8"
                    android:id="@+id/applicable_scopes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/meanings_container"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/main_color_word_b8"
                    android:id="@+id/exam_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="@+id/word"
                    app:layout_constraintTop_toBottomOf="@+id/applicable_scopes"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/tab_container"
                android:background="#f8f8f9"
                android:paddingTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:background="@android:color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    app:tabGravity="start"
                    app:tabIndicatorHeight="0dp"
                    app:tabMinWidth="0dp"
                    app:tabMode="scrollable"
                    app:tabPaddingBottom="0dp"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingStart="0dp"
                    app:tabPaddingTop="0dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="#283044"
                    app:tabTextAppearance="@style/WikiTabTextAppearance"
                    app:tabTextColor="#9ca6b8"/>
                <View
                    android:layout_gravity="start|top"
                    android:id="@+id/custom_indicator"
                    android:background="@drawable/tab_indicator"
                    android:visibility="visible"
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="24dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/tab_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_buttons"
        android:background="#f8f8f9"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_on_surface_variant3"
            android:gravity="center"
            android:id="@+id/btn_report_word"
            android:background="@drawable/bg_word_report_button"
            android:layout_width="60dp"
            android:layout_height="24dp"
            android:text="单词报错"
            android:layout_marginEnd="32dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/main_color_word_b8"
            android:id="@+id/btn_report"
            android:background="@drawable/bg_rounded_button_outline"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="举报"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
