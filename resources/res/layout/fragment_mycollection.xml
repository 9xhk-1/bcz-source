<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_mycollection_0"
    android:background="@color/main_color_white"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/words"
        android:tag="binding_1"
        android:background="@drawable/button_my_collection"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="138dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/my_tab_collection_words"
        android:drawableTop="@drawable/ic_collect_words_normal_default"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/article"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/article"
        android:tag="binding_2"
        android:background="@drawable/button_my_collection"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="138dp"
        android:text="@string/my_tab_collection_article"
        android:drawableTop="@drawable/ic_collect_article_normal_default"
        app:layout_constraintLeft_toRightOf="@+id/words"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/words"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/product"
        android:tag="binding_3"
        android:background="@drawable/button_my_collection"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="138dp"
        android:layout_marginTop="20dp"
        android:text="@string/my_tab_collection_product"
        android:drawableTop="@drawable/ic_collect_product_normal_default"
        app:layout_constraintLeft_toLeftOf="@+id/words"
        app:layout_constraintRight_toRightOf="@+id/words"
        app:layout_constraintTop_toBottomOf="@+id/words"/>
</androidx.constraintlayout.widget.ConstraintLayout>
