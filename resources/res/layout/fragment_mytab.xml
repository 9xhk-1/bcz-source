<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_tab"
    android:tag="layout/fragment_mytab_0"
    android:background="#f8f8f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="my_tab">
    <ImageView
        android:id="@+id/head_bg"
        android:layout_width="match_parent"
        android:layout_height="188dp"
        android:src="@drawable/bg_mytab_head"
        android:scaleType="centerCrop"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/user_info_layout"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/avatar"
                    android:tag="binding_2"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="68dp"
                    android:src="@drawable/ic_user_default_avatar"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:riv_border_color="@color/main_color_white"
                    app:riv_border_width="2dp"
                    app:riv_oval="true"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/main_color_word_822"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/name"
                    android:tag="binding_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"
                    android:maxEms="12"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintLeft_toRightOf="@+id/avatar"
                    app:layout_constraintRight_toLeftOf="@+id/tab_red_dot"
                    app:layout_constraintTop_toTopOf="@+id/avatar"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/main_color_word_7e"
                    android:gravity="left"
                    android:id="@+id/bcz_id"
                    android:tag="binding_4"
                    android:background="@drawable/bg_text_my_tab_id"
                    android:paddingLeft="6dp"
                    android:paddingTop="1dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintLeft_toLeftOf="@+id/name"
                    app:layout_constraintTop_toBottomOf="@+id/name"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/main_color_word_7e"
                    android:gravity="left"
                    android:id="@+id/gradle"
                    android:tag="binding_5"
                    android:background="@drawable/bg_text_my_tab_id"
                    android:paddingLeft="6dp"
                    android:paddingTop="1dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:layout_constraintLeft_toRightOf="@+id/bcz_id"
                    app:layout_constraintTop_toTopOf="@+id/bcz_id"/>
                <View
                    android:id="@+id/grade_red_dot"
                    android:tag="binding_6"
                    android:background="@drawable/shape_mytab_red_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    app:layout_constraintEnd_toEndOf="@+id/gradle"
                    app:layout_constraintTop_toTopOf="@+id/gradle"/>
                <ImageView
                    android:id="@+id/img_me_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_word_plan_arrow_right"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="@+id/avatar"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/avatar"
                    app:tint="@color/main_color_word_b8"/>
                <View
                    android:id="@+id/tab_red_dot"
                    android:tag="binding_7"
                    android:background="@drawable/shape_mytab_red_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/avatar"
                    app:layout_constraintRight_toLeftOf="@+id/img_me_more"
                    app:layout_constraintTop_toTopOf="@+id/avatar"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.baicizhan.main.activity.mytab.task.AchievementView
                android:id="@+id/study_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_info_layout"/>
            <com.baicizhan.main.activity.mytab.task.TasksView
                android:id="@+id/task_layout"
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/study_layout"/>
            <com.baicizhan.main.activity.mytab.device.MyDevicesView
                android:id="@+id/my_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/task_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/plan_layout"
                android:tag="binding_9"
                android:background="@drawable/bg_my_tab_item_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/my_devices">
                <include
                    android:id="@+id/my_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    layout="@layout/mytab_setting_basic_item_trans"/>
                <include
                    android:id="@+id/my_plan"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    layout="@layout/mytab_setting_basic_item_trans"/>
                <include
                    android:id="@+id/my_word_test"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    layout="@layout/mytab_setting_basic_item_trans"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/collect_layout"
                android:tag="binding_10"
                android:background="@drawable/bg_my_tab_item_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/plan_layout">
                <include
                    android:id="@+id/my_collection"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/mytab_setting_basic_item_trans"/>
                <include
                    android:id="@+id/my_exam"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:layout_constraintTop_toBottomOf="@+id/my_collection"
                    layout="@layout/mytab_setting_basic_item_trans"/>
                <include
                    android:id="@+id/my_money"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:layout_constraintTop_toBottomOf="@+id/my_exam"
                    layout="@layout/mytab_setting_basic_item_trans"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/help_layout"
                android:tag="binding_11"
                android:background="@drawable/bg_my_tab_item_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/collect_layout">
                <include
                    android:id="@+id/my_mall"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/mytab_setting_basic_item_trans"/>
                <include
                    android:id="@+id/give_praise"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:layout_constraintTop_toBottomOf="@+id/my_mall"
                    layout="@layout/mytab_setting_basic_item_trans"/>
                <include
                    android:id="@+id/help_and_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:layout_constraintTop_toBottomOf="@+id/give_praise"
                    layout="@layout/mytab_setting_basic_item_trans"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/action_bar"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/qrcode"
            android:tag="binding_12"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_my_tab_scan"
            android:scaleType="center"/>
        <ImageView
            android:id="@+id/setting"
            android:tag="binding_13"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/ic_my_tab_setting"
            android:scaleType="center"/>
    </LinearLayout>
</FrameLayout>
