<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_privates_ad_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/auto_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mytab_setting_switch_extended_item"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_word_7e"
        android:gravity="left"
        android:id="@+id/auto_size_hint"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/setting_privates_ad_setting_ad_closed_hint"
        android:lineSpacingExtra="5dp"
        app:layout_constraintTop_toBottomOf="@+id/auto_size"/>
    <include
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"
        layout="@layout/bcz_loading_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
