<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_reminder_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/reminder_system"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mytab_setting_basic_item"/>
    <include
        android:id="@+id/reminder_wechart"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/reminder_system"
        layout="@layout/mytab_setting_basic_item"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/bcz_loading_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
