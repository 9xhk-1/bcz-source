<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_switch_schedule_0"
    android:background="@color/main_color_weak_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/schedule_list"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/add_schedule_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/add_schedule_bg"
        android:tag="binding_2"
        android:background="@color/main_color_white"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_white"
        android:gravity="center"
        android:id="@+id/add_schedule"
        android:tag="binding_3"
        android:background="@drawable/bg_button_main_blue_rectangle_no_disable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/schedule_switch_add"
        app:layout_constraintBottom_toBottomOf="@+id/add_schedule_bg"
        app:layout_constraintLeft_toLeftOf="@+id/add_schedule_bg"
        app:layout_constraintRight_toRightOf="@+id/add_schedule_bg"
        app:layout_constraintTop_toTopOf="@+id/add_schedule_bg"/>
    <View
        android:tag="binding_4"
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="@+id/add_schedule_bg"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        layout="@layout/bcz_loading_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
