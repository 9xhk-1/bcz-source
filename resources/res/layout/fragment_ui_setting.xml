<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_ui_setting_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/auto_size"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/mytab_setting_switch_item"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_word_7e"
        android:gravity="left"
        android:id="@+id/auto_size_hint"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/setting_ui_setting_auto_size_hint"
        android:lineSpacingExtra="5dp"
        app:layout_constraintTop_toBottomOf="@+id/auto_size"/>
</androidx.constraintlayout.widget.ConstraintLayout>
