<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_userinfo_edit_education_0"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/college"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/userinfo_edit_edu_college"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/bachelor"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/userinfo_edit_edu_bachelor"
        app:layout_constraintTop_toBottomOf="@+id/college"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/post"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/userinfo_edit_edu_post_graduate"
        app:layout_constraintTop_toBottomOf="@+id/bachelor"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/phd"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/userinfo_edit_edu_phd"
        app:layout_constraintTop_toBottomOf="@+id/post"/>
    <ImageView
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_userinfo_sex_pickuped"
        app:layout_constraintBottom_toBottomOf="@+id/college"
        app:layout_constraintRight_toRightOf="@+id/college"
        app:layout_constraintTop_toTopOf="@+id/college"/>
    <ImageView
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_userinfo_sex_pickuped"
        app:layout_constraintBottom_toBottomOf="@+id/bachelor"
        app:layout_constraintRight_toRightOf="@+id/bachelor"
        app:layout_constraintTop_toTopOf="@+id/bachelor"/>
    <ImageView
        android:tag="binding_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_userinfo_sex_pickuped"
        app:layout_constraintBottom_toBottomOf="@+id/post"
        app:layout_constraintRight_toRightOf="@+id/post"
        app:layout_constraintTop_toTopOf="@+id/post"/>
    <ImageView
        android:tag="binding_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_userinfo_sex_pickuped"
        app:layout_constraintBottom_toBottomOf="@+id/phd"
        app:layout_constraintRight_toRightOf="@+id/phd"
        app:layout_constraintTop_toTopOf="@+id/phd"/>
    <View
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/college"/>
    <View
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/bachelor"/>
    <View
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/post"/>
    <View
        android:id="@+id/divider"
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/phd"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/cancel"
        android:tag="binding_9"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/cancel"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
