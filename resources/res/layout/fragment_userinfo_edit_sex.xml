<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_userinfo_edit_sex_0"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/man"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/userinfo_sex_man"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/women"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/userinfo_sex_woman"
        app:layout_constraintTop_toBottomOf="@+id/man"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/secret"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/userinfo_sex_secret"
        app:layout_constraintTop_toBottomOf="@+id/women"/>
    <ImageView
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_userinfo_sex_pickuped"
        app:layout_constraintBottom_toBottomOf="@+id/man"
        app:layout_constraintRight_toRightOf="@+id/man"
        app:layout_constraintTop_toTopOf="@+id/man"/>
    <ImageView
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_userinfo_sex_pickuped"
        app:layout_constraintBottom_toBottomOf="@+id/women"
        app:layout_constraintRight_toRightOf="@+id/women"
        app:layout_constraintTop_toTopOf="@+id/women"/>
    <ImageView
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:src="@drawable/ic_userinfo_sex_pickuped"
        app:layout_constraintBottom_toBottomOf="@+id/secret"
        app:layout_constraintRight_toRightOf="@+id/secret"
        app:layout_constraintTop_toTopOf="@+id/secret"/>
    <View
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/man"/>
    <View
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/women"/>
    <View
        android:id="@+id/divider"
        android:background="@color/main_color_weak_bg"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@+id/secret"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/cancel"
        android:tag="binding_7"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/cancel"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
