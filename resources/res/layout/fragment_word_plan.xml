<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/word_plan_tab"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="word_plan_tab">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/plan_cards"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <View
            android:id="@+id/divider"
            android:layout_width="16dp"
            android:layout_height="1dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.baicizhan.main.home.plan.winningStreak.WinningStreakBarView
            android:id="@+id/winning"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/divider"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/space_winning"
            android:layout_width="16dp"
            android:layout_height="1dp"
            app:layout_constraintLeft_toRightOf="@+id/winning"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/words_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_dark_search"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/messages"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.baicizhan.client.business.widget.RedDotImageView
            android:id="@+id/messages"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_messages"
            android:scaleType="center"
            android:tint="@color/top_bar_icon_and_text_color"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintTop_toTopOf="parent"
            app:redDotColor="@color/main_color_red"
            app:redDotPadding="2.2dp"
            app:redDotRadius="4dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/pop_down_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_pop_down_message"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
