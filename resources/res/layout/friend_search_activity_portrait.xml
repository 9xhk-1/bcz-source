<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/friend_search_activity_portrait_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/action_bar"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/action_bar_basic"/>
    <FrameLayout
        android:id="@+id/search_bar"
        android:background="#efeeea"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <RelativeLayout
            android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
            android:layout_gravity="center_vertical"
            android:id="@+id/search_frame"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/search_small_lens"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="3dp"
                android:src="@drawable/friend_search_manifying_lens"
                android:scaleType="centerInside"/>
            <ImageView
                android:id="@+id/search_clear"
                android:background="?attr/actionBarItemBackground"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="invisible"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="4dp"
                android:src="@drawable/searchwords_close_normal_default"
                android:scaleType="centerInside"
                android:layout_alignParentRight="true"
                android:alpha="0.5"/>
            <EditText
                android:textSize="@dimen/business_fs3"
                android:textColor="@color/business_dt7"
                android:textColorHint="?attr/color_message_subtitle"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/search_box"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/friend_search_hint"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/search_clear"
                android:layout_toRightOf="@+id/search_small_lens"
                android:inputType="text"
                android:imeOptions="flagNoExtractUi"/>
        </RelativeLayout>
    </FrameLayout>
    <FrameLayout
        android:tag="binding_1"
        android:background="#efeeea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar">
        <include layout="@layout/friend_system_suggestion_portrait"/>
        <include layout="@layout/friend_search_entry"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
