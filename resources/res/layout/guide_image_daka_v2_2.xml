<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/guide_image_daka_v2_2_0"
    android:background="#cc000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/guide_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_daka_v2_guide_2"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_daka_guide_line_2"
        app:layout_constraintBottom_toBottomOf="@+id/guide_text"
        app:layout_constraintEnd_toStartOf="@+id/guide_content"
        app:layout_constraintTop_toTopOf="@+id/guide_text"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/main_color_white"
        android:id="@+id/guide_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="左右横滑，切换打卡封面类型"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_content"
        app:layout_constraintEnd_toStartOf="@+id/guide_line"
        app:layout_constraintTop_toTopOf="@+id/guide_content"/>
    <ImageView
        android:id="@+id/next"
        android:layout_width="134dp"
        android:layout_height="49dp"
        android:layout_marginBottom="90dp"
        android:src="@drawable/img_guide_know_btn"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
