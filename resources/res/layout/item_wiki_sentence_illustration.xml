<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/voice"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="16dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"
        android:layout_alignParentRight="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/anim_audio_speaker"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/sentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@+id/voice"
        android:lineSpacingExtra="4dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/translation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="32dp"
        android:layout_below="@+id/sentence"
        android:lineSpacingExtra="4dp"/>
    <ImageView
        android:id="@+id/illustration"
        android:background="@drawable/bg_wiki_illustration"
        android:padding="0.5dp"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter"
        android:layout_below="@+id/translation"/>
</RelativeLayout>
