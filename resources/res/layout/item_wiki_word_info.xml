<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_wiki_word_info_0"
    android:background="@android:color/transparent"
    android:paddingTop="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/word_layout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/img_collect"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="32dp"
            android:textStyle="bold"
            android:textColor="@color/main_color_word_822"
            android:id="@+id/word"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            app:autoSizeMaxTextSize="32dp"
            app:autoSizeMinTextSize="10dp"
            app:autoSizeTextType="uniform"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="left"
        android:orientation="horizontal"
        android:id="@+id/split_text_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toStartOf="@+id/img_collect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_collect"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_collected_status"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/word_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/word_layout"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/phonetic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/word_layout"
        app:layout_constraintTop_toBottomOf="@+id/word_layout"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/voice_img"
        android:paddingRight="24dp"
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:paddingStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/phonetic"
        app:layout_constraintStart_toEndOf="@+id/phonetic"
        app:layout_constraintTop_toTopOf="@+id/phonetic"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/anim_audio_speaker"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/exam_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/word_layout"
        app:layout_constraintTop_toBottomOf="@+id/phonetic"/>
</androidx.constraintlayout.widget.ConstraintLayout>
