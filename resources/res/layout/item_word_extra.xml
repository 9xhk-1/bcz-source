<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp">
    <View
        android:id="@+id/bg_area"
        android:background="@drawable/bg_white_small_corner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/training_btn_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/extra_enter"
        android:background="@drawable/bg_button_learn_others"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="120dp"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_area"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/extra_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/extra_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bg_area"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_7e"
        android:ellipsize="end"
        android:id="@+id/extra_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_area"
        app:layout_constraintEnd_toStartOf="@+id/extra_enter"
        app:layout_constraintStart_toStartOf="@+id/extra_title"
        app:layout_constraintTop_toBottomOf="@+id/extra_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
