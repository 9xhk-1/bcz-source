<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="32dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:gravity="center_vertical"
        android:id="@+id/word"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="64dp"
        app:autoSizeMaxTextSize="32dp"
        app:autoSizeMinTextSize="10dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/collect"
        android:layout_width="24dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_word_collect"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/word"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/word"/>
    <com.wefika.flowlayout.FlowLayout
        android:id="@+id/phonetics_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/word"
        app:layout_constraintTop_toBottomOf="@+id/word">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/main_color_main_word"
            android:gravity="center_vertical"
            android:id="@+id/accent_usa"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            app:layout_constraintStart_toStartOf="@+id/word"
            app:layout_constraintTop_toBottomOf="@+id/word"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/accent_voice_usa"
            android:paddingRight="24dp"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:scaleType="centerInside"
            app:layout_constraintStart_toEndOf="@+id/accent_usa"
            app:layout_constraintTop_toBottomOf="@+id/word"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_audio_speaker"/>
    </com.wefika.flowlayout.FlowLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/noproguard_meanings_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phonetics_container"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/noproguard_word_comparative"
        android:background="@drawable/bg_wiki_word_relevance"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        app:layout_constraintStart_toStartOf="@+id/word"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_meanings_container"/>
    <Space
        android:id="@+id/noproguard_word_comparative_bottom_padding"
        android:layout_width="wrap_content"
        android:layout_height="7dp"
        app:layout_constraintStart_toStartOf="@+id/word"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_word_comparative"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/exams_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exams_barrier"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/exams_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="noproguard_meanings_container,noproguard_word_comparative_bottom_padding"/>
</androidx.constraintlayout.widget.ConstraintLayout>
