<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.baicizhan.client.business.widget.WordTextView
        android:id="@+id/word"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.067"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_main_word"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/word_meaning"
        android:paddingBottom="24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/word"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/hint_word"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cn_meaning_barrier"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/hint_phonetic"
        android:paddingBottom="52dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hint_word"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/tip"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="读出上方的单词"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/main_blue"
        android:gravity="center"
        android:id="@+id/next_btn"
        android:background="@drawable/button_study_wiki_blue"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="下一题"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hint_phonetic_barrier"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/record_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/review_record_state_press_record"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.92"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/record_anim"
        android:layout_width="176dp"
        android:layout_height="176dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_record"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_record"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/anim_recording_wave"/>
    <ImageView
        android:id="@+id/btn_record"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="-4dp"
        android:scaleType="center"
        app:layout_constraintBottom_toTopOf="@+id/record_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_word_reading_mic"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/cn_meaning_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/cn_meaning_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="word_meaning, cn_meaning_guideline"
        app:layout_constraintTop_toBottomOf="@+id/word_meaning"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/hint_phonetic_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"
        app:layout_constraintGuide_percent="0.56"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/hint_phonetic_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="hint_phonetic_guideline, hint_phonetic"/>
</androidx.constraintlayout.widget.ConstraintLayout>
