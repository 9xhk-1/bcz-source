<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/guide_kill"
        android:layout_width="92dp"
        android:layout_height="89dp"
        android:src="@drawable/ic_learning_guide_kill"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/guide_hint"
        android:layout_width="92dp"
        android:layout_height="128dp"
        android:src="@drawable/ic_learning_guide_hint"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/guide_voice"
        android:layout_width="92dp"
        android:layout_height="188dp"
        android:src="@drawable/ic_learning_guide_vocie"
        android:scaleType="fitXY"/>
</FrameLayout>
