<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/item"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/main_color_main_word"
            android:id="@+id/word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/main_color_word_hint"
            android:id="@+id/accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:lines="1"
            android:layout_toRightOf="@+id/word"
            android:layout_alignBaseline="@+id/word"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/main_color_word_7e"
            android:ellipsize="end"
            android:id="@+id/cnmean"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lines="1"
            android:layout_below="@+id/word"/>
        <View
            android:id="@+id/divider"
            android:background="@color/main_color_weak_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</FrameLayout>
