<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/mytab_setting_account_item_0"
    android:background="@color/main_color_white"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setting_account_mgr"/>
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <ImageView
        android:tag="binding_1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:scaleType="fitXY"/>
    <ImageView
        android:tag="binding_2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:scaleType="fitXY"/>
    <ImageView
        android:tag="binding_3"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:src="@drawable/ic_word_plan_arrow_right"
        app:tint="@color/main_color_word_b8"/>
</LinearLayout>
