<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:tag="layout/mytab_setting_extended_item_0"
    android:paddingLeft="20dp"
    android:paddingTop="14dp"
    android:paddingRight="20dp"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/title_value"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="220dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:ellipsize="end"
        android:id="@+id/sub_title"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        app:layout_constraintStart_toStartOf="@+id/title_value"
        app:layout_constraintTop_toBottomOf="@+id/title_value"
        app:layout_constraintWidth_max="220dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="right"
        app:constraint_referenced_ids="title_value,sub_title"/>
    <View
        android:tag="binding_3"
        android:background="@drawable/shape_mytab_red_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/title_value"
        app:layout_constraintLeft_toRightOf="@+id/title_value"
        app:layout_constraintTop_toTopOf="@+id/title_value"/>
    <TextView
        android:textSize="16sp"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@+id/description"
        android:tag="binding_4"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/barrier"
        app:layout_constraintRight_toLeftOf="@+id/arrow_right"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="40dp"/>
    <ImageView
        android:id="@+id/arrow_right"
        android:tag="binding_5"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_word_plan_arrow_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/main_color_word_b8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
