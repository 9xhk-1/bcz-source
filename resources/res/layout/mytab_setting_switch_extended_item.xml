<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/mytab_setting_switch_extended_item_0"
    android:background="@color/main_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/title_item"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.kyleduo.switchbutton.SwitchButton
        android:id="@+id/switcher"
        android:tag="binding_2"
        android:layout_width="51dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:offColor="@color/main_color_word_hint"
        app:onColor="@color/main_color_common_blue"
        app:thumbColor="@color/main_color_white"
        app:thumbPressedColor="@color/main_color_white"
        app:thumb_height="25dp"
        app:thumb_margin="3dp"
        app:thumb_width="25dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:ellipsize="end"
        android:id="@+id/sub_title"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title_item"
        app:layout_constraintTop_toBottomOf="@+id/title_item"
        app:layout_constraintWidth_max="248dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
