<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/mytab_setting_switch_item_0"
    android:background="@color/main_color_white"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_main_word"
        android:gravity="left"
        android:id="@+id/title_item"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <com.kyleduo.switchbutton.SwitchButton
        android:id="@+id/switcher"
        android:tag="binding_2"
        android:layout_width="51dp"
        android:layout_height="wrap_content"
        app:offColor="@color/main_color_word_hint"
        app:onColor="@color/main_color_common_blue"
        app:thumbColor="@color/main_color_white"
        app:thumbPressedColor="@color/main_color_white"
        app:thumb_height="25dp"
        app:thumb_margin="3dp"
        app:thumb_width="25dp"/>
</LinearLayout>
