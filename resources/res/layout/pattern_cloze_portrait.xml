<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/relativeLayout2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/frameLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintWidth_max="520dp">
        <com.baicizhan.main.customview.ClozeTextView
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/study_select_button_text"
            android:gravity="center"
            android:id="@+id/cloze_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="数据错误"
            android:layout_alignParentTop="true"
            app:highlight_color="@color/study_word"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/study_hint_etyma"
            android:gravity="center"
            android:id="@+id/cnmean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="60dp"
            android:text="sorry"
            android:layout_below="@+id/cloze_text"/>
        <FrameLayout
            android:id="@+id/hint_placeholder"
            android:background="@drawable/bg_study_hint"
            android:paddingLeft="24dp"
            android:paddingTop="24dp"
            android:paddingRight="24dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="36dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/cnmean">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/study_select_button_text"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/phonetic_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="media"/>
            <com.baicizhan.main.customview.HighlightTextView
                android:textSize="16sp"
                android:textColor="@color/study_select_button_text"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/media_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="media"
                app:highlight_color="@color/study_word"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/double_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.baicizhan.main.customview.HighlightTextView
                    android:textSize="16sp"
                    android:textColor="@color/study_select_button_text"
                    android:id="@+id/left_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="left"
                    app:highlight_color="@color/study_word"/>
                <View
                    android:background="#00000000"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>
                <com.baicizhan.main.customview.HighlightTextView
                    android:textSize="16sp"
                    android:textColor="@color/study_select_button_text"
                    android:id="@+id/right_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="right"
                    app:highlight_color="@color/study_word"/>
            </LinearLayout>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/trandition_hint_container"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.baicizhan.main.customview.ClozeTraditionHintView
                    android:id="@+id/trandition_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout2">
        <com.baicizhan.main.customview.DialView
            android:layout_gravity="center"
            android:id="@+id/dial_view"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
