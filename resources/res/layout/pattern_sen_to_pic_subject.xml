<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="4"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/topic_sentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/sentence_test_frequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>
    <View
        android:id="@+id/divider_mid"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.baicizhan.main.view.ControllableViewAnimator
        android:orientation="vertical"
        android:id="@+id/hint_switcher"
        android:background="@drawable/bg_study_hint"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:maxHeight="@dimen/learning_tip_sentence_max_height">
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="center"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/study_select_button_text"
                    android:ellipsize="end"
                    android:id="@+id/topic_sentence_translate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="center"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/study_select_button_text"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/topic_mean_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView
            android:layout_gravity="center"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/study_select_button_text"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:id="@+id/topic_mean_cn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.baicizhan.main.view.ControllableViewAnimator>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="4"/>
</LinearLayout>
