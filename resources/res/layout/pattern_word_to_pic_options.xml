<?xml version="1.0" encoding="utf-8"?>
<com.baicizhan.main.customview.FixedGridLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/option_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cellHeightWeight="3"
    app:cellWidthWeight="4"
    app:horizontalSpacing="3dp"
    app:numOfColumns="2"
    app:numOfRows="2"
    app:verticalSpacing="3dp">
    <FrameLayout
        android:background="@drawable/bg_study_option_shadow"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:shape="rectangle"
            android:soundEffectsEnabled="false"
            app:cardCornerRadius="8dp"
            app:cardElevation="0px"
            app:cardUseCompatPadding="false">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="@drawable/bg_study_pic_mask_press"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white_color"
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_study_pic_hit_gradient"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:singleLine="true"/>
            <ImageView
                android:layout_gravity="top|right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_study_result_pic_right"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <FrameLayout
        android:background="@drawable/bg_study_option_shadow"
