<?xml version="1.0" encoding="utf-8"?>
<com.baicizhan.main.phrasetraining.view.PhraseGroupHeader xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/T2"
        android:textColor="?attr/color_button_text_mediabar"
        android:gravity="center"
        android:id="@+id/phrase_group_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phrase_group_msg"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="8dp"/>
    <TextView
        android:textSize="@dimen/T1"
        android:textColor="?attr/color_button_text"
        android:gravity="center"
        android:id="@+id/phrase_group_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/phrase_group_download"
        android:drawableTop="?attr/drawable_download"
        android:drawablePadding="2dp"
        android:layout_below="@+id/phrase_group_msg"
        android:layout_centerHorizontal="true"/>
    <com.baicizhan.client.business.widget.CommentCircleProgressView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/phrase_group_downloading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/phrase_group_msg"
        android:layout_centerHorizontal="true"
        app:centerSquareWidth="5dp"
        app:circleBackgroundColor="?attr/color_progress_bg2"
        app:circleProgressColor="?attr/color_progress"
        app:circleRadius="9dp"
        app:strokeWidth="2dp"/>
    <View
        android:background="?attr/color_button_oval"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="53dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/phrase_group_msg"/>
</com.baicizhan.main.phrasetraining.view.PhraseGroupHeader>
