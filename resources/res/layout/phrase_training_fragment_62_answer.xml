<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="35dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/T7"
                android:textColor="?attr/color_progress"
                android:gravity="center"
                android:id="@+id/phrase_training_62_a_word_0"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:textSize="@dimen/T7"
                android:textColor="?attr/color_progress"
                android:gravity="center"
                android:id="@+id/phrase_training_62_a_word_1"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:textSize="@dimen/T7"
                android:textColor="?attr/color_progress"
                android:gravity="center"
                android:id="@+id/phrase_training_62_a_word_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:textSize="@dimen/T7"
                android:textColor="?attr/color_progress"
                android:gravity="center"
                android:id="@+id/phrase_training_62_a_word_3"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/T5"
            android:textColor="?attr/color_button_text_mediabar"
            android:gravity="center"
            android:id="@+id/phrase_training_62_a_middle_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"/>
        <TextView
            android:textSize="@dimen/T9"
            android:textColor="?attr/color_progress"
            android:gravity="center"
            android:id="@+id/phrase_training_62_a_middle_mean"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/T5"
            android:textColor="?attr/color_button_text_mediabar"
            android:gravity="center"
            android:id="@+id/phrase_training_62_a_end_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/T3"
        android:textColor="?attr/color_button_text"
        android:gravity="center"
        android:id="@+id/phrase_training_next_q"
        android:background="?attr/drawable_button_line"
        android:layout_width="114dp"
        android:layout_height="30dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="5dp"
        android:text="@string/phrase_training_next_question"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
