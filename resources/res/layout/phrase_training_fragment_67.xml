<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="35dp">
        <TextView
            android:textSize="@dimen/T9"
            android:textColor="?attr/color_list_text2"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/phrase_training_word"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="cut out"
            android:layout_weight="1"/>
        <com.baicizhan.main.customview.FixedGridLayout xmlns:grid="http://schemas.android.com/apk/res-auto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="17dp"
            android:layout_weight="1"
            grid:cellHeightWeight="1"
            grid:cellWidthWeight="1"
            grid:horizontalSpacing="4dp"
            grid:numOfColumns="2"
            grid:numOfRows="2"
            grid:verticalSpacing="4dp">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp">
                <com.baicizhan.client.business.widget.RecycleableImageView
                    android:id="@+id/phrase_training_img_0"
                    android:padding="4.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    grid:autoRecycle="true"/>
                <ImageView
                    android:id="@+id/phrase_training_tag_0"
                    android:background="#00000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/wrong_big_normal_default"
                    android:scaleType="center"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp">
                <com.baicizhan.client.business.widget.RecycleableImageView
                    android:id="@+id/phrase_training_img_1"
                    android:padding="4.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    grid:autoRecycle="true"/>
                <ImageView
                    android:id="@+id/phrase_training_tag_1"
                    android:background="#00000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/wrong_big_normal_default"
                    android:scaleType="center"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp">
                <com.baicizhan.client.business.widget.RecycleableImageView
                    android:id="@+id/phrase_training_img_2"
                    android:padding="4.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    grid:autoRecycle="true"/>
                <ImageView
                    android:id="@+id/phrase_training_tag_2"
                    android:background="#00000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/wrong_big_normal_default"
                    android:scaleType="center"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp">
                <com.baicizhan.client.business.widget.RecycleableImageView
                    android:id="@+id/phrase_training_img_3"
                    android:padding="4.5dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    grid:autoRecycle="true"/>
                <ImageView
                    android:id="@+id/phrase_training_tag_3"
                    android:background="#00000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/wrong_big_normal_default"
                    android:scaleType="center"/>
            </FrameLayout>
        </com.baicizhan.main.customview.FixedGridLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/phrase_training_sound_frame"
        android:background="?attr/drawable_button_line"
        android:layout_width="38dp"
        android:layout_height="30dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="5dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/phrase_training_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
