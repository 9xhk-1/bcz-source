<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewSwitcher
        android:id="@+id/hint_switcher"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inAnimation="@anim/business_push_up_in"
        android:outAnimation="@anim/business_push_up_out"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/option_container"
        app:layout_constraintEnd_toEndOf="@+id/option_container"
        app:layout_constraintStart_toStartOf="@+id/option_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/plusreview_listen_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/plusreview_listen_example"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </ViewSwitcher>
    <include
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hint_switcher"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintWidth_max="520dp"
        layout="@layout/pattern_pic_to_chin_options"/>
</androidx.constraintlayout.widget.ConstraintLayout>
