<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/score_img_normal_default"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/T5"
                android:textStyle="bold"
                android:textColor="@color/C123"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/raise_select_dialog_title"/>
            <TextView
                android:textSize="@dimen/T4"
                android:textColor="@color/C173"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="28dp"
                android:text="@string/raise_select_dialog_content"/>
            <View
                android:background="#dcdcdc"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="@dimen/T4"
                android:textStyle="bold"
                android:textColor="@color/C200"
                android:gravity="center"
                android:id="@+id/give_praise"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="赏个好评"/>
            <View
                android:background="#dcdcdc"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="@dimen/T4"
                android:textColor="@color/C173"
                android:gravity="center"
                android:id="@+id/give_criticism"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="我要吐槽"/>
            <View
                android:background="#dcdcdc"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <TextView
                android:textSize="@dimen/T4"
                android:textColor="@color/C173"
                android:gravity="center"
                android:id="@+id/refuse"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="残忍拒绝"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
