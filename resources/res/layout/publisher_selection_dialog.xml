<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/main_color_white"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/cancel"
        android:padding="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/main_color_main_word"
        android:gravity="center"
        android:id="@+id/ok"
        android:padding="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:layout_alignParentRight="true"/>
    <View
        android:id="@+id/divider"
        android:background="@color/main_color_weak_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/cancel"/>
    <com.aigestudio.wheelpicker.WheelPicker
        android:id="@+id/wheel"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_below="@+id/divider"
        app:wheel_atmospheric="true"
        app:wheel_curved="true"
        app:wheel_indicator="true"
        app:wheel_indicator_color="@color/main_color_weak_divider"
        app:wheel_indicator_size="1dp"
        app:wheel_item_text_color="@color/main_color_word_b8"
        app:wheel_item_text_size="20dp"
        app:wheel_selected_item_text_color="@color/main_color_main_word"
        app:wheel_visible_item_count="5"/>
</RelativeLayout>
