<?xml version="1.0" encoding="utf-8"?>
<com.baicizhan.main.customview.SkillTrainingMainItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_item_skill_training"
    android:paddingLeft="24dp"
    android:paddingTop="24dp"
    android:paddingRight="20dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="14sp"
            android:textColor="#ff283044"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ff9ca6b8"
            android:id="@+id/category"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#ff283044"
            android:id="@+id/progress_text"
            android:background="@drawable/skill_training_main_item_progress_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="12dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/type_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</com.baicizhan.main.customview.SkillTrainingMainItemView>
