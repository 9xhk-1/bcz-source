<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/study_wiki_fragment_v2_0"
    android:background="@color/main_color_common_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wiki_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/noproguard_bottom_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/noproguard_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/noproguard_kill"
        android:background="@drawable/button_study_bottom_bar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ic_study_slash"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_bottom_bg"
        app:layout_constraintLeft_toLeftOf="@+id/noproguard_bottom_bg"
        app:layout_constraintRight_toLeftOf="@+id/noproguard_continue_learn"
        app:layout_constraintTop_toTopOf="@+id/noproguard_bottom_bg"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/main_color_blue_dark"
        android:gravity="center"
        android:id="@+id/noproguard_continue_learn"
        android:background="@drawable/button_study_wiki_blue"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="2dp"
        android:text="@string/wiki_continue_next"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_bottom_bg"
        app:layout_constraintLeft_toRightOf="@+id/noproguard_kill"
        app:layout_constraintRight_toRightOf="@+id/noproguard_bottom_bg"
        app:layout_constraintTop_toTopOf="@+id/noproguard_bottom_bg"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/noproguard_bottom_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="noproguard_bottom_bg, noproguard_continue_learn, noproguard_kill"/>
    <ProgressBar
        android:id="@+id/progress"
        android:tag="binding_1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:indeterminateTint="#ff000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
