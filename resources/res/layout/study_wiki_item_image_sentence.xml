<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:tag="layout/study_wiki_item_image_sentence_0"
    android:paddingLeft="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/title"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/study_wiki_subitem_title"/>
    <ImageView
        android:id="@+id/voice"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="16dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/ic_searchwords_voice_2"
        android:scaleType="centerInside"
        app:layout_constraintLeft_toRightOf="@+id/sentence"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/sentence"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/voice"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/sentence_translate"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/sentence"
        app:layout_constraintTop_toBottomOf="@+id/sentence"/>
    <ImageView
        android:id="@+id/sentence_img"
        android:background="@drawable/bg_wiki_deformation"
        android:padding="0.5dp"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sentence_translate"/>
</androidx.constraintlayout.widget.ConstraintLayout>
