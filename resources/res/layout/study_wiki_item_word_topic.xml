<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:tag="layout/study_wiki_item_word_topic_0"
    android:paddingLeft="20dp"
    android:paddingTop="20dp"
    android:paddingRight="16dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/collect"
        android:layout_width="40dp"
        android:layout_height="50dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/collect_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_uncollected"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="32dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:gravity="top|left"
        android:id="@+id/word"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:maxWidth="200dp"
        app:autoSizeMaxTextSize="32dp"
        app:autoSizeMinTextSize="10dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/collect"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.wefika.flowlayout.FlowLayout
        android:id="@+id/accent_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:layout_below="@+id/word"
        app:layout_constraintTop_toBottomOf="@+id/word">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/main_color_main_word"
            android:gravity="center_vertical"
            android:id="@+id/accent"
            android:paddingRight="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="25dp"/>
        <ImageView
            android:id="@+id/accent_voice"
            android:paddingRight="24dp"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_searchwords_voice_2"
            android:scaleType="centerInside"/>
    </com.wefika.flowlayout.FlowLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/cnmean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:layout_below="@+id/accent_container"
        app:layout_constraintTop_toBottomOf="@+id/accent_container"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/variant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="4dp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@+id/cnmean"/>
</androidx.constraintlayout.widget.ConstraintLayout>
