<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/switch_schedule_item_0"
    android:background="@drawable/bg_shadow_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/animation_bg"
        android:background="@drawable/bg_schedule_item_animation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/book_bg"
        android:layout_width="54dp"
        android:layout_height="72dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/main_color_main_word"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/book_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="10dp"
        android:maxLines="1"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toRightOf="@+id/book_bg"
        app:layout_constraintRight_toLeftOf="@+id/current_learn"
        app:layout_constraintTop_toTopOf="@+id/book_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_blue_dark"
        android:id="@+id/current_learn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:text="@string/schedule_switch_title_current"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/book_bg"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/delete"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:text="@string/schedule_switch_delete"
        android:drawableLeft="@drawable/ic_schedule_delete"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/book_finish_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/book_name"
        app:layout_constraintTop_toBottomOf="@+id/book_name"/>
    <ProgressBar
        android:id="@+id/plan_progress_bar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:layout_marginEnd="20dp"
        android:progressTint="@color/primary_blue_200"
        android:backgroundTint="#66e6e9ee"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/book_name"
        app:layout_constraintTop_toBottomOf="@+id/book_finish_tips"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ProgressBar
        android:id="@+id/plan_progress_bar_masted"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:layout_marginEnd="20dp"
        android:progressTint="@color/main_color_blue_dark"
        android:backgroundTint="@color/main_color_blue_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/book_name"
        app:layout_constraintTop_toBottomOf="@+id/book_finish_tips"
        style="?android:attr/progressBarStyleHorizontal"/>
    <View
        android:id="@+id/plan_progress_bar_masted_dot"
        android:background="@drawable/ic_book_master_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_master_desc"
        app:layout_constraintStart_toStartOf="@+id/plan_progress_bar"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_master_desc"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_master_desc"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="已学单词"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/plan_progress_bar_masted_dot"
        app:layout_constraintTop_toBottomOf="@+id/plan_progress_bar"/>
    <View
        android:id="@+id/plan_progress_bar_learned_dot"
        android:background="@drawable/ic_book_learned_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_learned_desc"
        app:layout_constraintStart_toEndOf="@+id/wp_plan_master_desc"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_learned_desc"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_learned_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="已学单词"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/plan_progress_bar_learned_dot"
        app:layout_constraintTop_toBottomOf="@+id/plan_progress_bar"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_progress_value"
        android:layout_width="47dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_learned_desc"
        app:layout_constraintEnd_toEndOf="@+id/plan_progress_bar"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_learned_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
