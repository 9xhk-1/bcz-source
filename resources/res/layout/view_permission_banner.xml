<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/view_permission_banner_0"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/banner"
        android:background="@drawable/bg_round_ffffff_4dp"
        android:padding="16dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="12dp">
        <ImageView
            android:id="@+id/noproguard_notification_img"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_event_notification"
            android:scaleType="centerInside"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/main_color_word_822"
            android:id="@+id/noproguard_permission_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/noproguard_notification_img"
            app:layout_constraintLeft_toRightOf="@+id/noproguard_notification_img"
            app:layout_constraintTop_toTopOf="@+id/noproguard_notification_img"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/title_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="noproguard_notification_img, noproguard_permission_title"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/main_color_main_word"
            android:id="@+id/permission_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/noproguard_permission_title"
            app:layout_goneMarginTop="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
