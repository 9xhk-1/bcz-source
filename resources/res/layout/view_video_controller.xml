<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/bg"
        android:background="@drawable/bg_video_controller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/noproguard_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="46dp"
        android:scaleType="centerInside"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_action_bar_back_light_old"/>
    <ImageView
        android:id="@+id/noproguard_screenshot"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_camera"
        android:scaleType="center"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/noproguard_back"/>
    <ImageView
        android:id="@+id/noproguard_play_or_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="20dp"
        android:scaleType="center"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_video_controller_play"/>
    <TextView
        android:textColor="#ffffff"
        android:id="@+id/noproguard_time_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_play_or_pause"
        app:layout_constraintStart_toEndOf="@+id/noproguard_play_or_pause"
        app:layout_constraintTop_toTopOf="@+id/noproguard_play_or_pause"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/noproguard_skip"
        android:background="@drawable/btn_video_controller_skip"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="@string/video_control_skip_inactivate"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_play_or_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/noproguard_play_or_pause"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/noproguard_speed"
        android:background="@drawable/btn_video_controller_speed"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_skip"
        app:layout_constraintEnd_toStartOf="@+id/noproguard_skip"
        app:layout_constraintTop_toTopOf="@+id/noproguard_skip"/>
    <SeekBar
        android:id="@+id/noproguard_seeker"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginBottom="17dp"
        android:maxHeight="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/bg_video_controller_seek_bar"
        android:minHeight="6dp"
        android:thumb="@drawable/btn_video_controller_seek_thumb"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:splitTrack="false"
        app:layout_constraintBottom_toTopOf="@+id/noproguard_play_or_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ImageView
        android:id="@+id/noproguard_preview"
        android:background="@drawable/bg_video_controller_preview"
        android:layout_width="@dimen/video_controller_preview_width"
        android:layout_height="@dimen/video_controller_preview_height"
        android:layout_marginBottom="2dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/noproguard_seeker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/noproguard_preview_time_area"
        android:background="@drawable/bg_video_controller_preview_time"
        android:layout_width="0dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_preview"
        app:layout_constraintEnd_toEndOf="@+id/noproguard_preview"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/noproguard_preview"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/noproguard_preview_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:drawablePadding="4dp"
        android:fontFamily="serif"
        app:layout_constraintBottom_toBottomOf="@+id/noproguard_preview"
        app:layout_constraintEnd_toEndOf="@+id/noproguard_preview"
        app:layout_constraintStart_toStartOf="@+id/noproguard_preview"/>
    <ImageView
        android:id="@+id/screenshot_preview"
        android:layout_width="90dp"
        android:layout_height="160dp"
        android:layout_marginTop="14dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noproguard_screenshot"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/control_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="noproguard_skip,noproguard_play_or_pause,noproguard_seeker,noproguard_time_progress,noproguard_speed,noproguard_screenshot,noproguard_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/preview_area"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="noproguard_preview,noproguard_preview_time_area,noproguard_preview_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
