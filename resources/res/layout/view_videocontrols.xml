<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/vcv_play"
        android:background="#00000000"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/tv_big_play_normal_default"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/bottom_line"
        android:background="@color/C50"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_margin="0dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/T1"
            android:textColor="@android:color/white"
            android:id="@+id/vcv_txt_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/vcv_img_fullscreen"
            android:padding="2dp"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/videoplayer_fullscreen_normal_default"
            android:scaleType="fitXY"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/T1"
            android:textColor="@android:color/white"
            android:id="@+id/vcv_txt_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:layout_toLeftOf="@+id/vcv_img_fullscreen"
            android:layout_centerVertical="true"/>
        <SeekBar
            android:id="@+id/vcv_seekbar"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="1dp"
            android:indeterminate="false"
            android:indeterminateDrawable="@drawable/fvl_progress"
            android:progressDrawable="@drawable/fvl_progress"
            android:minHeight="1dp"
            android:thumb="@drawable/fvl_control_thumb"
            android:thumbOffset="8dp"
            android:layout_toLeftOf="@+id/vcv_txt_total"
            android:layout_toRightOf="@+id/vcv_txt_elapsed"
            android:layout_centerVertical="true"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </RelativeLayout>
</RelativeLayout>
