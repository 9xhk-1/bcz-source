<?xml version="1.0" encoding="utf-8"?>
<com.baicizhan.main.home.plan.view.WordPlanInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_white_small_corner"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/wp_vertical_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.baicizhan.main.view.AspectRoundImageView
        android:id="@+id/wp_book_cover"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_book_cover_default"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"
        app:aspectRatio="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riv_corner_radius="2dp"/>
    <View
        android:id="@+id/wp_adjust_click_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_book_cover"
        app:layout_constraintLeft_toRightOf="@+id/wp_book_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wp_book_cover"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/wp_book_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/wp_plan_adjust"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/wp_book_cover"
        app:layout_constraintTop_toTopOf="@+id/wp_book_cover"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_7e"
        android:gravity="center"
        android:id="@+id/wp_plan_adjust"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="修改"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_book_name"
        app:layout_constraintStart_toEndOf="@+id/wp_book_name"
        app:layout_constraintTop_toTopOf="@+id/wp_book_name"/>
    <ImageView
        android:id="@+id/wp_adjust_img"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_word_plan_arrow_right"
        android:scaleType="centerInside"
        android:tint="@color/main_color_word_7e"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_adjust"
        app:layout_constraintLeft_toRightOf="@+id/wp_plan_adjust"/>
    <View
        android:id="@+id/wp_adjust_group"
        android:background="@android:color/transparent"
        android:layout_width="48dp"
        android:layout_height="26dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_book_name"
        app:layout_constraintEnd_toEndOf="@+id/wp_adjust_img"
        app:layout_constraintStart_toStartOf="@+id/wp_plan_adjust"
        app:layout_constraintTop_toTopOf="@+id/wp_book_name"/>
    <ImageView
        android:id="@+id/wp_plan_update"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_book_update"
        app:layout_constraintBottom_toBottomOf="@+id/wp_book_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/wp_plan_progress_bar"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/wp_book_name"
        app:layout_constraintTop_toBottomOf="@+id/wp_book_name"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/wp_review_round_tip"
        android:background="@drawable/bg_main_dark"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_progress_value"
        app:layout_constraintStart_toStartOf="@+id/wp_plan_progress_bar"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_progress_value"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_progress_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/wp_review_round_tip"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_period_desc"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_plan_period_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/wp_plan_progress_bar"
        app:layout_constraintTop_toBottomOf="@+id/wp_plan_progress_bar"/>
    <View
        android:id="@+id/wp_book_area_divider"
        android:background="@color/color_gray_06_40"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/wp_plan_progress_bar"
        app:layout_constraintStart_toStartOf="@+id/wp_book_cover"
        app:layout_constraintTop_toBottomOf="@+id/wp_book_cover"/>
    <ImageView
        android:id="@+id/wp_bg_done_today"
        android:visibility="gone"
        android:layout_width="184dp"
        android:layout_height="184dp"
        android:layout_marginBottom="59dp"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_button_area_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/bg_plan_done_today"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_word_822"
        android:id="@+id/wp_plan_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="今日计划"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wp_book_area_divider"/>
    <FrameLayout
        android:id="@+id/wp_plan_quizzer_punch_card"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/wp_plan_title"
        app:layout_constraintStart_toEndOf="@+id/wp_plan_title"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_title">
        <TextView
            android:textSize="12dp"
            android:textColor="#ff9500"
            android:gravity="center"
            android:background="@drawable/bg_button_word_plan_quizzer_punch_card"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="1dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去打卡"
            android:drawableRight="@drawable/ic_word_plan_arrow_right"
            android:fontFamily="sans-serif-medium"
            android:drawableTint="#ff9500"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_blue_dark"
        android:ellipsize="end"
        android:gravity="right"
        android:id="@+id/wp_book_link"
        android:paddingLeft="4dp"
        android:paddingTop="6dp"
        android:paddingRight="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="160dp"
        android:lines="1"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wp_book_area_divider"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_822"
        android:id="@+id/wp_new_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/word_plan_card_label_new"
        app:layout_constraintStart_toStartOf="@+id/wp_plan_title"
        app:layout_constraintTop_toBottomOf="@+id/wp_plan_title"/>
    <TextView
        android:textSize="48dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_word_822"
        android:id="@+id/wp_new_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/wp_new_label"
        app:layout_constraintTop_toBottomOf="@+id/wp_new_label"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/wp_new_area_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="right"
        app:constraint_referenced_ids="wp_vertical_center,wp_new_count"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_822"
        android:id="@+id/wp_review_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/word_plan_card_label_review"
        app:layout_constraintStart_toEndOf="@+id/wp_new_area_barrier"
        app:layout_constraintTop_toTopOf="@+id/wp_new_label"/>
    <TextView
        android:textSize="48dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_word_822"
        android:id="@+id/wp_review_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/wp_vertical_center"
        app:layout_constraintTop_toTopOf="@+id/wp_new_count"/>
    <ImageView
        android:id="@+id/wp_book_detail_message"
        android:visibility="gone"
        android:layout_width="108dp"
        android:layout_height="30dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/img_book_detail_tip"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/wp_book_cover"
        app:layout_constraintTop_toTopOf="@+id/wp_plan_progress_value"/>
    <ImageView
        android:id="@+id/wp_multi_mode_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_multimode_homepage_tips"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/wp_plan_adjust"
        app:layout_constraintTop_toBottomOf="@+id/wp_plan_adjust"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/wp_group_review_counts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="wp_review_label,wp_review_count"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/wp_group_plan_doing"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="wp_new_area_barrier,wp_plan_progress_value,wp_new_label,wp_book_area_divider,wp_plan_adjust,wp_new_count,wp_book_cover,wp_plan_period_desc,wp_book_name,wp_plan_progress_bar,wp_plan_title,wp_adjust_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.baicizhan.main.view.AspectRoundImageView
        android:id="@+id/wp_bg_done"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_book_plan_done"
        android:scaleType="fitXY"
        app:aspectRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/wp_btn_main_done"
        android:background="@drawable/bg_button_main_blue_no_disable"
        android:layout_width="148dp"
        android:layout_height="36dp"
        android:layout_marginBottom="132dp"
        android:text="学习其他计划"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/wp_cover_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wp_btn_main_done"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:id="@+id/wp_tip_of_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="明天将进入总复习"
        app:layout_constraintBottom_toTopOf="@+id/wp_btn_main_done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.baicizhan.main.view.AspectRoundImageView
        android:id="@+id/wp_book_cover_done"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_book_cover_default"
        android:scaleType="fitXY"
        app:aspectRatio="0.75"
        app:layout_constraintBottom_toTopOf="@+id/wp_cover_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.265"
        app:riv_corner_radius="2dp"/>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/wp_book_name_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLines="1"
        android:lineSpacingExtra="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wp_book_cover_done"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_main_word"
        android:id="@+id/wp_plan_summary_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/wp_book_name_done"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/wp_group_done_btn_main"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="wp_btn_main_done,wp_cover_anchor,wp_tip_of_done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/wp_group_plan_done"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="wp_bg_done,wp_plan_summary_done,wp_book_name_done,wp_book_cover_done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/wp_button_area_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/wp_btn_main"
        android:background="@drawable/bg_button_main_blue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="开始背单词 !"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_button_area_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_words_light_button_text"
        android:gravity="center"
        android:id="@+id/wp_btn_left"
        android:background="@drawable/bg_button_learn_others"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="加量学习"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_button_area_bottom"
        app:layout_constraintEnd_toStartOf="@+id/wp_vertical_center"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_words_light_button_text"
        android:gravity="center"
        android:id="@+id/wp_btn_right"
        android:background="@drawable/bg_button_learn_others"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="打卡"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_button_area_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/wp_vertical_center"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/main_color_words_light_button_text"
        android:gravity="center"
        android:id="@+id/wp_btn_main_light"
        android:background="@drawable/bg_button_learn_others"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="打卡"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/wp_button_area_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/main_color_word_b8"
        android:gravity="center_vertical"
        android:id="@+id/wp_tip_of_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="84dp"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/wp_error_view"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_error_refresh"/>
    <com.baicizhan.client.business.view.RotatingImageView
        android:id="@+id/wp_loading_view"
        android:background="@drawable/bg_white_small_corner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/loading_dots_normal_default"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/map_learn_tip"
        android:visibility="gone"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/wp_plan_progress_value"
        app:layout_constraintTop_toBottomOf="@+id/wp_plan_progress_value">
        <ImageView
            android:background="@drawable/ic_pop_angle"
            android:layout_width="12dp"
            android:layout_height="6dp"
            android:layout_marginStart="12dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/bg_round_ffffff_4dp"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#283044">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/main_color_white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/learn_tab_word_map_tips"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/tip_close"
                android:background="@drawable/ic_close_white"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</com.baicizhan.main.home.plan.view.WordPlanInfoView>
