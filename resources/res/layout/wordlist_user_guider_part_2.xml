<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wordlist_user_guider_part_2"
    android:background="#cc000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.baicizhan.main.view.AspectRoundImageView
        android:id="@+id/hint1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="255.5dp"
        android:src="@drawable/wordlist_hint3_normal_default"
        android:layout_centerHorizontal="true"
        app:aspectRatio="4.1667"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:src="@drawable/wordlist_hint4_normal_default"
        android:layout_below="@+id/hint1"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
